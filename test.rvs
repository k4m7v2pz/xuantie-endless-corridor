#!/usr/bin/env rvs
# test.rvs — 无尽回廊短时运行验证（4 秒自动关闭，单窗口）
# 用法: rvs test.rvs   （若尚未构建，先 rvs scripts/build-macos.rvs）
write-output "=== 无尽回廊 短时验证（4 秒） ==="
if (test-path --path corridor) {
  /bin/bash scripts/bash/run-check.sh
  read-file --path /tmp/xtl-test.state
} else {
  write-output "未找到 ./corridor，请先运行: rvs scripts/build-macos.rvs"
}

// 剧情播放器原型：纯文本，不上渲染，用来验证 JSON 剧情层的字段设计

函 加载剧情(路径) {
    设 读果 = 文件.读(路径)
    若 读果.成功 == 假 {
        示("读取失败：" & 读果.错误)
        返 空
    }
    设 数据 = 解(读果.值)
    若 数据 == 空 {
        示("解析失败：文件为空，或带 UTF-8 BOM（Windows 记事本会加），或 JSON 语法有错。")
        返 空
    }
    返 数据
}

函 数节点(事件) {
    设 数 = 0
    遍历 编 于 事件 {
        数 = 数 + 1
    }
    返 数
}

函 播放() {
    设 数据 = 加载剧情("剧情/幕01.json")
    若 数据 == 空 {
        返
    }

    设 事件 = 数据["事件"]
    设 当前 = 数据["起始"]

    示("════════════════════════════")
    示("《" & 数据["幕名"] & "》 第 " & 字(数据["幕编号"]) & " 幕 · 共 " & 字(数节点(事件)) & " 个节点")
    示("════════════════════════════")

    设 起 = 时.毫秒()
    设 上起 = 起
    设 记录 = []

    当 当前 != "" {
        设 节点 = 事件[当前]
        若 节点 == 空 {
            示("剧情断了：找不到节点「" & 当前 & "」")
            断
        }

        示("")
        示("── " & 节点["标题"] & " ──")
        设 字节总 = 0
        遍历 行 于 节点["正文"] {
            示(行)
            字节总 = 字节总 + 行.长度
        }

        设 后来 = ""
        设 题 = 节点["谜题"]
        设 选项表 = 节点["选项"]

        设 试了 = 0
        若 题 != 空 {
            示("")
            示("【" & 题["提示"] & "】")
            设 定了 = 假
            当 定了 == 假 {
                设 答 = 输("输入答案 > ")
                试了 = 试了 + 1
                若 答 == 题["答案"] {
                    示(题["对白"])
                    后来 = 题["对"]
                    定了 = 真
                } 否 {
                    示(题["错白"])
                    设 放 = 输("再试一次？（回车再试，输入「撬」放弃） ")
                    若 放 == "撬" {
                        后来 = 题["错"]
                        定了 = 真
                    }
                }
            }
            示("（试了 " & 字(试了) & " 次）")
        }

        若 题 == 空 且 选项表 != 空 {
            示("")
            设 序号 = 1
            遍历 项 于 选项表 {
                示("  " & 字(序号) & ". " & 项["文字"])
                序号 = 序号 + 1
            }
            设 转 = 整(输("选择 > "))
            若 转.成功 且 转.值 >= 1 且 转.值 <= 选项表.长度 {
                后来 = 选项表[转.值 - 1]["到"]
            }
            若 后来 == "" {
                示("（没有这个选项，按第一个处理）")
                后来 = 选项表[0]["到"]
            }
        }

        若 题 == 空 且 选项表 == 空 {
            设 后 = 节点["后继"]
            若 后 == 空 {
                输("（回车结束）")
                后来 = ""
            } 否 {
                输("（回车继续）")
                后来 = 后
            }
        }

        设 段 = 时.毫秒() - 上起
        记录.追加({"编号": 当前, "毫秒": 段, "字数": 字节总 / 3, "试答": 试了})
        上起 = 时.毫秒()

        当前 = 后来
    }

    设 总 = 时.毫秒() - 起
    示("")
    示("════════ 本次结束 ════════")
    示("走过 " & 字(记录.长度) & " 个节点 · 总耗时 " & 字(总) & " 毫秒")
    示("")
    设 总字 = 0
    遍历 条 于 记录 {
        总字 = 总字 + 条["字数"]
    }
    示("编号     耗时        字数")
    遍历 条 于 记录 {
        示("  " & 条["编号"] & "   " & 字(条["毫秒"]) & " ms   约 " & 字(条["字数"]) & " 字")
    }
    示("")
    示("合计约 " & 字(总字) & " 字，平均 " & 字(总 / 总字) & " 毫秒每字")
}

播放()

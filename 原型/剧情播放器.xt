// 剧情播放器原型：纯文本，不上渲染，用来验证 JSON 剧情层的字段设计
// 支持多幕：读 剧情/目录.json 列出幕文件，顺序播放
// 音频：只借渲染库的音频设备（不建窗口），节点可用「音效」合成音效

引 "渲染" 予 R
引 "文本" 予 文
外 函 SetTraceLogLevel(级别: 整)

函 加载剧情(路径) {
    设 读果 = 文件.读(路径)
    若 读果.成功 == 假 {
        示("读取失败：" & 读果.错误)
        返 空
    }
    设 数据 = 解(读果.值)
    若 数据 == 空 {
        示("解析失败：文件为空，或带 UTF-8 BOM（Windows 记事本会加），或 JSON 语法有错。")
        返 空
    }
    返 数据
}

函 写日志(日志路径, 记录) {
    设 行表 = []
    行表.追加("编号	毫秒	字数	试答")
    遍历 条 于 记录 {
        行表.追加(条["编号"] & "	" & 字(条["毫秒"]) & "	" & 字(条["字数"]) & "	" & 字(条["试答"]))
    }
    文件.写(日志路径, 行表.连接("\n"))
}

函 数节点(事件) {
    设 数 = 0
    遍历 编 于 事件 {
        数 = 数 + 1
    }
    返 数
}

// 玄铁无 时.延时 导出（编译不报、运行才炸），只能自己等
设 上移行 = "[1A[1G[K"

// 逐字出现：每步原地改写上一行，末尾接 50ms 短点击
函 打字行(行, 每字毫秒) {
    设 列 = 文.字符数组(行)
    设 已 = ""
    设 首 = 真
    遍历 单 于 列 {
        已 = 已 & 单
        若 首 {
            示(已)
            首 = 假
        } 否 {
            示(上移行 & 已)
        }
        设 音 = R.合成器(0, 70, {"波形":"白噪","音量":0.5,"包络":{"起音":0,"衰减":10,"延持电平":0.12,"释音":55},"EQ":{"中音":2,"高音":3}})
        若 音 > 0 {
            R.播音效(音)
            等毫秒(每字毫秒)
            R.释音效(音)
        } 否 {
            等毫秒(每字毫秒)
        }
    }
}

函 等毫秒(时长) {
    设 起 = 时.毫秒()
    设 转 = 0
    当 时.毫秒() - 起 < 时长 {
        转 = 转 + 1
    }
}

// 演出层：清屏 + 绝对定位贴图 + 红字，终端只能用 ANSI 硬拼
函 播放演出(演) {
    设 素材 = 演["素材"]
    遍历 帧 于 演["帧"] {
        设 串 = "[2J[H"
        设 脸名 = 帧["脸"]
        若 脸名 != 空 {
            设 行表 = 素材[脸名]
            设 列 = 帧["列"]
            设 起行 = 帧["行"]
            设 i = 0
            遍历 行 于 行表 {
                串 = 串 & "[" & 字(起行 + i) & ";" & 字(列) & "H" & 行
                i = i + 1
            }
        }
        设 红字 = 帧["字"]
        若 红字 != 空 {
            串 = 串 & "[31m[" & 字(帧["字行"]) & ";" & 字(帧["字列"]) & "H" & 红字 & "[0m"
        }
        若 帧["响"] == 真 {
            串 = 串 & ""
        }
        示(串)
        等毫秒(帧["停"])
    }
}

函 示行囊(行囊) {
    若 行囊.长度 == 0 {
        示("（行囊是空的。）")
        返
    }
    示("【行囊】")
    设 序 = 1
    遍历 物 于 行囊 {
        示("  " & 字(序) & ". " & 物)
        序 = 序 + 1
    }
}

函 播放一幕(路径, 记录, 上末, 日志路径, 行囊) {
    设 数据 = 加载剧情(路径)
    若 数据 == 空 {
        返 ""
    }

    设 事件 = 数据["事件"]
    设 当前 = 数据["起始"]

    示("")
    示("════════════════════════════")
    示("《" & 数据["幕名"] & "》 第 " & 字(数据["幕编号"]) & " 幕 · 共 " & 字(数节点(事件)) & " 个节点")
    示("════════════════════════════")

    若 上末 != "" {
        设 场表 = 数据["过场"]
        若 场表 != 空 {
            设 段 = 场表[上末]
            若 段 != 空 {
                示("")
                遍历 行 于 段 {
                    示(行)
                }
                输("（回车继续）")
            }
        }
    }

    设 上起 = 时.毫秒()
    设 末 = ""
    设 上音表 = []

    当 当前 != "" {
        设 节点 = 事件[当前]
        若 节点 == 空 {
            示("剧情断了：找不到节点「" & 当前 & "」")
            断
        }

        若 上音表.长度 > 0 {
            遍历 句 于 上音表 {
                R.释音效(句)
            }
            上音表 = []
        }

        示("")
        示("── " & 节点["标题"] & " ──")
        设 字节总 = 0
        设 打字毫 = 0
        若 节点["打字"] != 空 {
            若 节点["打字"] == 真 {
                打字毫 = 140
            } 否 {
                打字毫 = 节点["打字"]
            }
        }
        遍历 行 于 节点["正文"] {
            若 打字毫 > 0 {
                打字行(行, 打字毫)
            } 否 {
                示(行)
            }
            字节总 = 字节总 + 行.长度
        }

        设 音效 = 节点["音效"]
        若 音效 != 空 {
            设 延 = 0
            若 音效["延迟"] != 空 {
                延 = 音效["延迟"]
            }
            若 延 > 0 {
                设 等起 = 时.毫秒()
                当 时.毫秒() - 等起 < 延 {
                }
            }
            设 序 = 音效["序列"]
            若 序 != 空 {
                遍历 条 于 序 {
                    若 条["间隔"] != 空 {
                        等毫秒(条["间隔"])
                    }
                    设 音 = R.加载音效(条["文件"])
                    若 音 > 0 {
                        R.播音效(音)
                        上音表.追加(音)
                    }
                }
            } 否 {
                设 频 = 0
                若 音效["频率"] != 空 {
                    频 = 音效["频率"]
                }
                设 毫 = 600
                若 音效["毫秒"] != 空 {
                    毫 = 音效["毫秒"]
                }
                设 音 = 0
                若 音效["文件"] != 空 {
                    音 = R.加载音效(音效["文件"])
                } 抑 音效["选项"] != 空 {
                    音 = R.合成器(频, 毫, 音效["选项"])
                } 否 {
                    音 = R.合成音效(频, 毫)
                }
                若 音 > 0 {
                    R.播音效(音)
                    上音表.追加(音)
                }
            }
        }

        设 红表 = 节点["红字"]
        若 红表 != 空 {
            遍历 行 于 红表 {
                示("[31m" & 行 & "[0m")
            }
        }

        设 后来 = ""
        设 查 = 节点["调查"]
        设 已办 = 假
        若 查 != 空 {
            设 走 = 假
            设 待说 = ""
            设 待附 = ""
            当 走 == 假 {
                示("")
                示("【这里能看的】")
                设 序号0 = 1
                遍历 项 于 查["对象"] {
                    示("  " & 字(序号0) & ". " & 项["名"])
                    序号0 = 序号0 + 1
                }
                示("  b. 看行囊          x. 走")
                若 待说 != "" {
                    示("")
                    示(待说)
                    待说 = ""
                }
                若 待附 != "" {
                    示(待附)
                    待附 = ""
                }
                设 入 = 输("> ")
                若 入 == "x" 或 入 == "" {
                    走 = 真
                    设 去 = 查["出口"]
                    设 规 = 查["按件数"]
                    若 规 != 空 {
                        遍历 条 于 规 {
                            若 行囊.长度 >= 条["件数"] 且 去 == 查["出口"] {
                                去 = 条["到"]
                            }
                        }
                    }
                    后来 = 去
                } 否 {
                    若 入 == "b" {
                        示行囊(行囊)
                        待说 = ""
                        待附 = ""
                    } 否 {
                        设 号 = 整(入)
                        若 号.成功 且 号.值 >= 1 且 号.值 <= 查["对象"].长度 {
                            设 项 = 查["对象"][号.值 - 1]
                            待说 = "你查看了 " & 字(号.值) & " -「" & 项["名"] & "」：" & 项["话"]
                            设 物 = 项["给"]
                            若 物 != 空 {
                                行囊.追加(物)
                                待附 = "（收进行囊：" & 物 & "）"
                            }
                        } 否 {
                            待说 = "（没有这个。输编号，b 看行囊，x 走。）"
                        }
                    }
                }
            }
            已办 = 真
        }

        设 演 = 节点["演出"]
        若 演 != 空 {
            播放演出(演)
        }

        设 题 = 节点["谜题"]
        设 选项表 = 节点["选项"]
        设 试了 = 0

        若 题 != 空 {
            示("")
            示("【" & 题["提示"] & "】")
            设 定了 = 假
            当 定了 == 假 {
                设 答 = 输("输入答案 > ")
                试了 = 试了 + 1
                设 判对 = 假
                设 中变 = 空
                若 答 == 题["答案"] {
                    判对 = 真
                }
                设 可受 = 题["可接受"]
                若 可受 != 空 {
                    遍历 候 于 可受 {
                        若 答 == 候 {
                            判对 = 真
                        }
                    }
                }
                设 变体表 = 题["变体"]
                若 变体表 != 空 {
                    遍历 变 于 变体表 {
                        遍历 候 于 变["接受"] {
                            若 答 == 候 {
                                判对 = 真
                                中变 = 变
                            }
                        }
                    }
                }
                若 判对 == 真 {
                    若 中变 != 空 {
                        示(中变["对白"])
                        后来 = 中变["对"]
                    } 否 {
                        示(题["对白"])
                        后来 = 题["对"]
                    }
                    定了 = 真
                } 否 {
                    示(题["错白"])
                    若 试了 >= 10 {
                        示("（试了很多次。你放弃了。）")
                        后来 = 题["错"]
                        定了 = 真
                    } 否 {
                        设 放 = 输("1 再数一遍 / 2 不数了 > ")
                        若 放 == "2" {
                            后来 = 题["错"]
                            定了 = 真
                        }
                        若 放 != "1" 且 放 != "2" {
                            示("这里只能输 1 或 2。")
                        }
                    }
                }
            }
            示("（试了 " & 字(试了) & " 次）")
        }

        若 题 == 空 且 选项表 != 空 且 已办 == 假 {
            示("")
            设 序号 = 1
            遍历 项 于 选项表 {
                示("  " & 字(序号) & ". " & 项["文字"])
                序号 = 序号 + 1
            }
            设 转 = 整(输("选择 > "))
            若 转.成功 且 转.值 >= 1 且 转.值 <= 选项表.长度 {
                后来 = 选项表[转.值 - 1]["到"]
            }
            若 后来 == "" {
                示("（没有这个选项，按第一个处理）")
                后来 = 选项表[0]["到"]
            }
        }

        若 题 == 空 且 选项表 == 空 且 已办 == 假 {
            设 后 = 节点["后继"]
            设 续读 = 真
            设 提示 = "（回车继续）"
            若 后 != 空 且 行囊.长度 > 0 {
                提示 = "（回车继续，b 看行囊）"
            }
            当 续读 == 真 {
                设 键 = 输(提示)
                若 键 == "b" {
                    示行囊(行囊)
                } 否 {
                    续读 = 假
                }
            }
            若 后 == 空 {
                后来 = ""
            } 否 {
                后来 = 后
            }
        }

        设 段 = 时.毫秒() - 上起
        记录.追加({"编号": 当前, "毫秒": 段, "字数": 字节总 / 3, "试答": 试了})
        写日志(日志路径, 记录)
        上起 = 时.毫秒()

        末 = 当前
        当前 = 后来
    }

    返 末
}

函 播放() {
    设 目录 = 加载剧情("剧情/目录.json")
    若 目录 == 空 { 返 }

    SetTraceLogLevel(6)   // 静默 raylib 的 INFO 行，免得糊在终端最上面
    R.初始化音频()

    设 幕表 = 目录["幕"]

    设 作品 = 目录["作品"]
    若 作品 != 空 {
        示("")
        示("════════════════════════════")
        示("  " & 作品)
        示("════════════════════════════")
    }

    示("从第几幕开始？（回车从第 1 幕开始，直接跑长剧情很省时间）")
    设 起幕号 = 1
    设 输入幕 = 整(输("幕号 > "))
    若 输入幕.成功 {
        若 输入幕.值 >= 1 且 输入幕.值 <= 幕表.长度 {
            起幕号 = 输入幕.值
        }
    }

    若 文件.存在?("日志") == 假 {
        文件.建目录("日志")
    }
    设 记录 = []
    设 行囊 = []
    设 起 = 时.毫秒()
    设 日志路径 = "日志/游玩-" & 字(起) & ".txt"
    设 序 = 1
    设 上末 = ""

    遍历 幕路径 于 幕表 {
        若 序 >= 起幕号 {
            上末 = 播放一幕(幕路径, 记录, 上末, 日志路径, 行囊)
        }
        序 = 序 + 1
    }

    设 总 = 时.毫秒() - 起
    示("")
    示("════════ 本次结束 ════════")
    示("走过 " & 字(记录.长度) & " 个节点 · 总耗时 " & 字(总) & " 毫秒")
    示("")
    示("编号     耗时        字数    试答")
    设 总字 = 0
    遍历 条 于 记录 {
        示("  " & 条["编号"] & "   " & 字(条["毫秒"]) & " ms   " & 字(条["字数"]) & " 字   " & 字(条["试答"]))
        总字 = 总字 + 条["字数"]
    }
    示("")
    若 总字 > 0 {
        示("合计约 " & 字(总字) & " 字，平均 " & 字(总 / 总字) & " 毫秒每字")
    }
    示("逐节点明细已写入：" & 日志路径)
    R.关闭音频()
}

播放()

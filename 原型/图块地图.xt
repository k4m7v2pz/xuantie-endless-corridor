// 图块原型：48 网格的俯视地图，一楼地砖 + 两格高柜子 + 占位与遮挡
// ============================================================
// 目的只有一个：把「一格地板、两格高物件」这三条（占位两格、脚在下格、按底边排序）
// 跑起来看效果。美术全是色块，等 assets 里进真图再换，引擎不动。
// 操作：WASD / 方向键 逐格走，ESC 退出。
// ============================================================

引 "渲染" 予 R
引 "文本" 予 文

// === 窗口 ===
设 窗宽 = 800
设 窗高 = 600
设 场偏x = 16
设 场偏y = 96        // 上方留出远墙顶面的空间

// === 读地图数据 ===
设 地图 = 空
设 读果 = 文件.读("原型/地图01.json")
若 读果.成功 == 真 {
    地图 = 解(读果.值)
}
若 地图 == 空 {
    示("地图读不出来：原型/地图01.json")
}

设 格 = 地图["格"]
设 图行 = 地图["行"]
设 图宽 = 地图["宽"]
设 图高 = 地图["高"]
设 物件表 = 地图["物件"]
设 起x = 地图["起点"]["x"]
设 起y = 地图["起点"]["y"]

// === 走位（逐格） ===
设 玩家格x = 起x
设 玩家格y = 起y
设 每格秒 = 0.45
设 走中 = 假
设 向x = 0
设 向y = 0
设 步起x = 0
设 步起y = 0
设 步已走 = 0.0
设 玩家px = 24         // 玩家方块边长
设 退出 = 假

// === 碰撞：格子是否不可走 ===
// 墙看地图字符，物件按「脚格 + 上半格」两格都挡。
// 只挡脚格的话，玩家能走进柜子上半格，半个身子埋进去 —— 这是这个原型要证伪的事。
函 被挡(cx, cy) {
    若 cx < 0 或 cy < 0 或 cx >= 图宽 或 cy >= 图高 { 返 真 }
    设 串 = 图行[cy]
    设 列 = 文.字符数组(串)
    若 列[cx] == "#" { 返 真 }
    遍历 件 于 物件表 {
        设 脚x = 件["x"]
        设 脚y = 件["y"]
        若 脚x == cx 且 脚y == cy { 返 真 }
        若 件["高"] == 2 且 脚x == cx 且 脚y - 1 == cy { 返 真 }
    }
    返 假
}

函 起步(dx, dy) {
    若 被挡(玩家格x + dx, 玩家格y + dy) { 返 }
    向x = dx
    向y = dy
    步起x = 玩家格x
    步起y = 玩家格y
    步已走 = 0.0
    走中 = 真
}

// 玩家当前格坐标（像素，world 系，不含场偏）
函 玩家位x() {
    若 走中 { 返 步起x * 格 + 向x * 整(步已走).值 }
    返 玩家格x * 格
}

// 底边（world y）：遮挡排序就按它比
函 玩家底边() {
    若 走中 { 返 (步起y * 格 + 向y * 整(步已走).值) + 玩家px }
    返 玩家格y * 格 + 玩家px
}

// 物件底边：脚格的下沿
函 件底边(件) {
    返 (件["y"] + 1) * 格
}

// === 绘制 ===
// 地面：一格一块，隔格换色，靠色差看出格子
函 绘地面() {
    设 cy = 0
    当 cy < 图高 {
        设 cx = 0
        当 cx < 图宽 {
            设 串 = 图行[cy]
            设 列 = 文.字符数组(串)
            若 列[cx] != "#" {
                设 基 = 34
                若 (cx + cy) % 2 == 0 { 基 = 38 }
                R.绘矩形(场偏x + cx * 格, 场偏y + cy * 格, 格, 格, 基, 基 - 2, 基 + 8, 255)
                R.绘矩形(场偏x + cx * 格, 场偏y + cy * 格, 格, 1, 基 + 8, 基 + 6, 基 + 16, 255)
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
}

// 远墙（第一行）：正面 + 顶面都画 —— 斜俯视里上半屏的墙能看见这两截
函 绘远墙() {
    设 cx = 0
    当 cx < 图宽 {
        设 串 = 图行[0]
        设 列 = 文.字符数组(串)
        若 列[cx] == "#" {
            设 x = 场偏x + cx * 格
            设 y = 场偏y
            // 正面
            R.绘矩形(x, y, 格, 格, 26, 24, 32, 255)
            // 顶面：两片三角形拼一个平行四边形，斜 6、高 14
            R.绘三角(x, y, x + 格, y, x + 格 - 6, y - 14, 58, 54, 66, 255)
            R.绘三角(x, y, x + 格 - 6, y - 14, x + 6, y - 14, 58, 54, 66, 255)
        }
        cx = cx + 1
    }
}

// 近墙（最后一行）：只剩一条棱 —— 近侧墙背对你，只能看到墙顶
函 绘近墙() {
    设 cx = 0
    当 cx < 图宽 {
        设 串 = 图行[图高 - 1]
        设 列 = 文.字符数组(串)
        若 列[cx] == "#" {
            设 x = 场偏x + cx * 格
            设 y = 场偏y + (图高 - 1) * 格
            R.绘矩形(x, y, 格, 12, 44, 41, 51, 255)
            R.绘矩形(x, y, 格, 2, 62, 58, 70, 255)
        }
        cx = cx + 1
    }
}

// 左右两列墙：侧面只看见一面，一格高就够
函 绘边墙() {
    设 cy = 1
    当 cy < 图高 - 1 {
        设 x = 场偏x
        R.绘矩形(x, 场偏y + cy * 格, 格, 格, 24, 22, 30, 255)
        设 xr = 场偏x + (图宽 - 1) * 格
        R.绘矩形(xr, 场偏y + cy * 格, 格, 格, 24, 22, 30, 255)
        cy = cy + 1
    }
}

// 一个物件：正面（格 × 高格）+ 顶面（平行四边形）
函 绘件(件) {
    设 wx = 场偏x + 件["x"] * 格
    设 底 = 场偏y + (件["y"] + 1) * 格
    设 高 = 件["高"] * 格
    设 顶 = 底 - 高
    若 件["图"] == "柜" {
        R.绘矩形(wx, 顶, 格, 高, 74, 58, 44, 255)
        R.绘矩形(wx, 顶, 格, 3, 96, 78, 60, 255)
        R.绘矩形(wx + 6, 顶 + 12, 格 - 12, 2, 58, 45, 35, 255)
        R.绘矩形线(wx, 顶, 格, 高, 40, 32, 25, 255)
    }
    若 件["图"] == "箱" {
        R.绘矩形(wx, 顶, 格, 高, 62, 50, 38, 255)
        R.绘矩形线(wx, 顶, 格, 高, 38, 30, 22, 255)
    }
    // 顶面
    R.绘三角(wx, 顶, wx + 格, 顶, wx + 格 - 6, 顶 - 10, 104, 84, 64, 255)
    R.绘三角(wx, 顶, wx + 格 - 6, 顶 - 10, wx + 6, 顶 - 10, 104, 84, 64, 255)
}

// 按底边分流：比玩家底边小的先画（会被玩家盖住），大的后画（盖住玩家）
函 绘件分流(较小) {
    遍历 件 于 物件表 {
        设 该小 = 件底边(件) <= 玩家底边()
        若 较小 且 该小 { 绘件(件) }
        若 (非 较小) 且 (非 该小) { 绘件(件) }
    }
}

函 绘玩家() {
    设 x = 场偏x + 玩家位x() + (格 - 玩家px) / 2
    设 y = 场偏y + (玩家底边() - 玩家px)
    R.绘矩形(x, y, 玩家px, 玩家px, 168, 164, 180, 255)
    R.绘矩形(x, y, 玩家px, 4, 196, 192, 208, 255)
    R.绘矩形线(x, y, 玩家px, 玩家px, 88, 84, 100, 255)
}

// === 主循环 ===
R.初始化窗口(窗宽, 窗高, "图块原型")

当 非 R.窗口应关闭?() {
    设 dt = R.取帧时间()

    若 走中 {
        步已走 = 步已走 + 格 * dt * 1.0 / 每格秒
        若 步已走 >= 格 {
            玩家格x = 步起x + 向x
            玩家格y = 步起y + 向y
            走中 = 假
            步已走 = 0.0
        }
    }
    若 非 走中 {
        若 R.键按下?(87) 或 R.键按下?(265) { 起步(0, -1) }
        若 R.键按下?(83) 或 R.键按下?(264) { 起步(0, 1) }
        若 R.键按下?(65) 或 R.键按下?(263) { 起步(-1, 0) }
        若 R.键按下?(68) 或 R.键按下?(262) { 起步(1, 0) }
    }
    若 R.键刚按下?(256) { 退出 = 真 }

    R.开始绘图()
    R.清背景(8, 7, 12, 255)
    绘地面()
    绘边墙()
    绘远墙()
    绘件分流(真)
    绘玩家()
    绘件分流(假)
    绘近墙()
    R.结束绘图()

    若 退出 { 断 }
}

R.关闭窗口()

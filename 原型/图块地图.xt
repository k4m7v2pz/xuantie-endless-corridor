// 图块原型：48 网格的俯视地图，地砖 + 两格高物件 + 朝向 + 空格调查 + 主/暂停菜单
// ============================================================
// 目的：把「一格地板、两格高物件」的三条口径（占位两格、脚在下格、按底边排序）跑起来看效果，
// 并把最小可操作的界面补齐：朝向可辨、能对物件按空格调查、ESC 进暂停层而不是直接退。
// 美术全是色块，等 assets 里进真图再换，引擎不动。
// 操作：WASD/方向键 逐格走，空格 调查面前的东西，空格/回车 关掉对话，
//       ESC 在世界里 = 暂停菜单，在主菜单里 = 直接退出。
// ============================================================

引 "渲染" 予 R
引 "文本" 予 文
外 函 XT_GetRenderWidth(): 整

// === 窗口 ===
设 窗宽 = 800
设 窗高 = 600
设 场偏横 = 16
设 场偏纵 = 96        // 上方留出远墙顶面的空间

// === 读地图数据 ===
设 地图 = 空
设 读结果 = 文件.读("原型/地图01.json")
若 读结果.成功 == 真 {
    地图 = 解(读结果.值)
}
若 地图 == 空 {
    示("地图读不出来：原型/地图01.json")
}

设 格边 = 地图["格"]
设 图行 = 地图["行"]
设 图宽 = 地图["宽"]
设 图高 = 地图["高"]
设 物件表 = 地图["物件"]
设 传送表 = 地图["传送"]
若 传送表 == 空 { 传送表 = [] }
设 当前图 = "原型/地图01.json"
// 地图比窗口窄就水平居中，换小图时不会贴左上角
场偏横 = (窗宽 - 图宽 * 格边) / 2
设 起横 = 地图["起点"]["x"]
设 起纵 = 地图["起点"]["y"]

// === 走位（逐格） ===
设 玩家格横 = 起横
设 玩家格纵 = 起纵
设 每格秒 = 0.2      // 常速：5 格/秒（RPG Maker 默认约 4 格/秒，恐怖游戏普遍更快些）
设 疾行格秒 = 0.12   // 按住 Shift 快走：约 8.3 格/秒
设 当前格秒 = 0.2
设 走中 = 假
设 向横 = 0
设 向纵 = 0
设 步起横 = 0
设 步起纵 = 0
设 步已走 = 0.0
设 玩家边长 = 24
设 退出 = 假

// 朝向：单独记，起步时更新；没走过之前默认朝下
设 朝横 = 0
设 朝纵 = 1

// === 界面状态 ===
// 场状态：0=主菜单 1=世界里走 2=暂停菜单 3=说框（照完东西看字）
设 场状态 = 0
设 主菜单项 = ["开始", "退出"]
设 暂停项 = ["继续", "回到主菜单", "退出"]
设 选目 = 0
设 说框文 = ""
设 说框开 = 假
设 鼠横 = 0
设 鼠纵 = 0
// 同一帧里刚用 ESC/空格打开的层，不能被同一个按键立刻关掉
设 本帧已开 = 假
// 说框开着时按方向键 → 边框发白，500ms 内由 100% 淡到 0
设 辉光 = 0.0
设 辉光起 = 0

// === 字体 ===
设 字体 = 0
设 字体路径 = "/System/Library/Fonts/Supplemental/Arial Unicode.ttf"
设 像素比 = 1
若 R.取屏幕宽() > 0 {
    像素比 = XT_GetRenderWidth() / R.取屏幕宽()
}
若 像素比 < 1 { 像素比 = 1 }

// 参考串必须把要画的字全塞进去，漏的字会显示成问号
// 参考串 = 所有会画出来的界面文字 + 每件东西的描述，全部拼进去
设 参考 = "图块原型暂停开始退出继续回到主菜单WASD 走 / Shift 快走 / 空格 调查 / ESC 暂停空格 或 回车 关掉这里没什么可看的东西柜箱这是一只。"
// 注意：换图后画的描述来自别的 JSON，所以要把「地图集」里每张图的描述全收进来，
// 只收当前这张，换图后会满屏问号。
设 地图集 = 地图["地图集"]
若 地图集 == 空 { 地图集 = ["原型/地图01.json"] }
遍历 图路 于 地图集 {
    设 集读结果 = 文件.读(图路)
    若 集读结果.成功 {
        设 集读图 = 解(集读结果.值)
        遍历 某件 于 集读图["物件"] {
            若 某件["描述"] != 空 { 参考 = 参考 & 某件["描述"] }
        }
    }
}

// === 命中 ===
函 命中(画横, 画纵, 框横, 框纵, 框宽, 框高) {
    若 画横 < 框横 { 返 假 }
    若 画横 > 框横 + 框宽 { 返 假 }
    若 画纵 < 框纵 { 返 假 }
    若 画纵 > 框纵 + 框高 { 返 假 }
    返 真
}

// === 文字 ===
函 绘字(内容, 画横, 画纵, 字号, 红, 绿, 蓝, 透明度) {
    R.绘字体文字(字体, 内容, 画横, 画纵, 字号, 1, 红, 绿, 蓝, 透明度)
}

函 字宽(内容, 字号) {
    返 R.量字体文字(字体, 内容, 字号, 1)
}

// === 换图 ===
// 传送点是「可走的格子 + 一个到图坐标」；走到那格就载入新图、落到指定格。
函 载地图(路径, 落横, 落纵) {
    设 读结果 = 文件.读(路径)
    若 读结果.成功 == 假 {
        示("换图失败：" & 路径)
        返 假
    }
    设 新图 = 解(读结果.值)
    若 新图 == 空 {
        示("换图解析失败：" & 路径)
        返 假
    }
    当前图 = 路径
    地图 = 新图
    格边 = 地图["格"]
    图行 = 地图["行"]
    图宽 = 地图["宽"]
    图高 = 地图["高"]
    物件表 = 地图["物件"]
    传送表 = 地图["传送"]
    若 传送表 == 空 { 传送表 = [] }
    场偏横 = (窗宽 - 图宽 * 格边) / 2
    玩家格横 = 落横
    玩家格纵 = 落纵
    走中 = 假
    步已走 = 0.0
    返 真
}

函 查传送() {
    遍历 传送条 于 传送表 {
        若 传送条["x"] == 玩家格横 且 传送条["y"] == 玩家格纵 {
            载地图(传送条["到图"], 传送条["到x"], 传送条["到y"])
            返 真
        }
    }
    返 假
}

// === 碰撞：墙看地图字符，物件「脚格 + 上半格」两格都挡 ===
// 只挡脚格的话玩家能走进柜子上半格，半个身子埋进去 —— 这是这个原型要证伪的事。
函 被挡(格横, 格纵) {
    若 格横 < 0 或 格纵 < 0 或 格横 >= 图宽 或 格纵 >= 图高 { 返 真 }
    设 行串 = 图行[格纵]
    设 字列 = 文.字符数组(行串)
    若 字列[格横] == "#" { 返 真 }
    遍历 某件 于 物件表 {
        设 物件横 = 某件["x"]
        设 物件纵 = 某件["y"]
        若 物件横 == 格横 且 物件纵 == 格纵 { 返 真 }
        若 某件["高"] == 2 且 物件横 == 格横 且 物件纵 - 1 == 格纵 { 返 真 }
    }
    返 假
}

函 起步(走横, 走纵) {
    // 先转身再看能不能走：贴着墙/柜子按方向键，人不动也要转过去，
    // 否则「脸朝右站在柜子下、想朝上调查」永远做不到。
    朝横 = 走横
    朝纵 = 走纵
    若 被挡(玩家格横 + 走横, 玩家格纵 + 走纵) { 返 }
    向横 = 走横
    向纵 = 走纵
    步起横 = 玩家格横
    步起纵 = 玩家格纵
    步已走 = 0.0
    走中 = 真
}

函 玩家画横() {
    若 走中 { 返 步起横 * 格边 + 向横 * 整(步已走).值 }
    返 玩家格横 * 格边
}

// 底边：脚踩格子下沿；遮挡排序按它比
函 玩家底边() {
    若 走中 { 返 (步起纵 * 格边 + 向纵 * 整(步已走).值) + 格边 }
    返 (玩家格纵 + 1) * 格边
}

函 件底边(某件) {
    返 (某件["y"] + 1) * 格边
}

// === 调查 ===
// 单格小件：四面都能查。
// 两格高物件：只有「正面」能查 —— 正面是朝下的那一面，人得站在它下面、脸朝上。
// 从左右侧面查没有反应，就像现实里贴着柜子侧面看，看到的是柜帮而不是柜门。
函 面前件() {
    设 面前横 = 玩家格横 + 朝横
    设 面前纵 = 玩家格纵 + 朝纵
    遍历 某件 于 物件表 {
        若 某件["高"] == 2 {
            若 朝纵 == -1 且 某件["x"] == 面前横 且 某件["y"] == 面前纵 { 返 某件 }
        } 否 {
            若 某件["x"] == 面前横 且 某件["y"] == 面前纵 { 返 某件 }
        }
    }
    返 空
}

函 调查() {
    设 某件 = 面前件()
    若 某件 != 空 {
        设 文句 = 某件["描述"]
        若 文句 == 空 { 文句 = "这是一只" & 某件["图"] & "。" }
        说框文 = 文句
    } 否 {
        说框文 = "这里没什么可看的东西。"
    }
    说框开 = 真
    场状态 = 3
    本帧已开 = 真
}

// === 绘制 ===
函 绘地面() {
    设 格纵 = 0
    当 格纵 < 图高 {
        设 格横 = 0
        当 格横 < 图宽 {
            设 行串 = 图行[格纵]
            设 字列 = 文.字符数组(行串)
            若 字列[格横] != "#" {
                设 地色 = 34
                若 (格横 + 格纵) % 2 == 0 { 地色 = 38 }
                R.绘矩形(场偏横 + 格横 * 格边, 场偏纵 + 格纵 * 格边, 格边, 格边, 地色, 地色 - 2, 地色 + 8, 255)
                R.绘矩形(场偏横 + 格横 * 格边, 场偏纵 + 格纵 * 格边, 格边, 1, 地色 + 8, 地色 + 6, 地色 + 16, 255)
            }
            格横 = 格横 + 1
        }
        格纵 = 格纵 + 1
    }
}

// 传送点画在格子里：一圈亮边 + 中间一道缝，走进去就知道是门
函 绘门() {
    遍历 传送条 于 传送表 {
        设 画横 = 场偏横 + 传送条["x"] * 格边
        设 画纵 = 场偏纵 + 传送条["y"] * 格边
        R.绘矩形线(画横 + 2, 画纵 + 2, 格边 - 4, 格边 - 4, 176, 150, 84, 255)
        R.绘矩形(画横 + 格边 / 2 - 1, 画纵 + 6, 2, 格边 - 12, 120, 102, 58, 255)
    }
}

// 屋里的墙（柱子、隔断）：不画就是黑洞，得给一块墙面 + 一道亮边
函 绘内墙() {
    设 格纵 = 1
    当 格纵 < 图高 - 1 {
        设 行串 = 图行[格纵]
        设 字列 = 文.字符数组(行串)
        设 格横 = 1
        当 格横 < 图宽 - 1 {
            若 字列[格横] == "#" {
                设 画横 = 场偏横 + 格横 * 格边
                设 画纵 = 场偏纵 + 格纵 * 格边
                R.绘矩形(画横, 画纵, 格边, 格边, 26, 24, 32, 255)
                R.绘矩形(画横, 画纵, 格边, 3, 58, 54, 66, 255)
            }
            格横 = 格横 + 1
        }
        格纵 = 格纵 + 1
    }
}

// 远墙：正面 + 顶面（斜俯视里上半屏的墙能看见这两截）
函 绘远墙() {
    设 格横 = 0
    当 格横 < 图宽 {
        设 行串 = 图行[0]
        设 字列 = 文.字符数组(行串)
        若 字列[格横] == "#" {
            设 画横 = 场偏横 + 格横 * 格边
            设 画纵 = 场偏纵
            R.绘矩形(画横, 画纵, 格边, 格边, 26, 24, 32, 255)
            R.绘三角(画横, 画纵, 画横 + 格边, 画纵, 画横 + 格边 - 6, 画纵 - 14, 58, 54, 66, 255)
            R.绘三角(画横, 画纵, 画横 + 格边 - 6, 画纵 - 14, 画横 + 6, 画纵 - 14, 58, 54, 66, 255)
        }
        格横 = 格横 + 1
    }
}

// 近墙：只剩一条棱
函 绘近墙() {
    设 格横 = 0
    当 格横 < 图宽 {
        设 行串 = 图行[图高 - 1]
        设 字列 = 文.字符数组(行串)
        若 字列[格横] == "#" {
            设 画横 = 场偏横 + 格横 * 格边
            设 画纵 = 场偏纵 + (图高 - 1) * 格边
            R.绘矩形(画横, 画纵, 格边, 12, 44, 41, 51, 255)
            R.绘矩形(画横, 画纵, 格边, 2, 62, 58, 70, 255)
        }
        格横 = 格横 + 1
    }
}

函 绘边墙() {
    设 格纵 = 1
    当 格纵 < 图高 - 1 {
        R.绘矩形(场偏横, 场偏纵 + 格纵 * 格边, 格边, 格边, 24, 22, 30, 255)
        设 右横 = 场偏横 + (图宽 - 1) * 格边
        R.绘矩形(右横, 场偏纵 + 格纵 * 格边, 格边, 格边, 24, 22, 30, 255)
        格纵 = 格纵 + 1
    }
}

函 绘件(某件) {
    设 件左横 = 场偏横 + 某件["x"] * 格边
    设 件底 = 场偏纵 + (某件["y"] + 1) * 格边
    设 高 = 某件["高"] * 格边
    设 件顶 = 件底 - 高
    若 某件["图"] == "柜" {
        R.绘矩形(件左横, 件顶, 格边, 高, 74, 58, 44, 255)
        R.绘矩形(件左横, 件顶, 格边, 3, 96, 78, 60, 255)
        R.绘矩形(件左横 + 6, 件顶 + 12, 格边 - 12, 2, 58, 45, 35, 255)
        R.绘矩形线(件左横, 件顶, 格边, 高, 40, 32, 25, 255)
    }
    若 某件["图"] == "箱" {
        R.绘矩形(件左横, 件顶, 格边, 高, 62, 50, 38, 255)
        R.绘矩形线(件左横, 件顶, 格边, 高, 38, 30, 22, 255)
    }
    R.绘三角(件左横, 件顶, 件左横 + 格边, 件顶, 件左横 + 格边 - 6, 件顶 - 10, 104, 84, 64, 255)
    R.绘三角(件左横, 件顶, 件左横 + 格边 - 6, 件顶 - 10, 件左横 + 6, 件顶 - 10, 104, 84, 64, 255)
}

// 按底边分流：比玩家小的先画（会被玩家盖住），大的后画（盖住玩家）
函 绘件分流(画矮的) {
    遍历 某件 于 物件表 {
        设 本件矮 = 件底边(某件) <= 玩家底边()
        若 画矮的 且 本件矮 { 绘件(某件) }
        若 (非 画矮的) 且 (非 本件矮) { 绘件(某件) }
    }
}

// 朝向用方块内一条贴边的短杠表示：朝哪边，杠就贴哪条边
函 绘朝向杠(画横, 画纵) {
    设 杠长 = 12
    若 朝横 == 0 且 朝纵 == -1 { R.绘矩形(画横 + (玩家边长 - 杠长) / 2, 画纵 - 2, 杠长, 4, 236, 232, 248, 255) }
    若 朝横 == 0 且 朝纵 == 1 { R.绘矩形(画横 + (玩家边长 - 杠长) / 2, 画纵 + 玩家边长 - 2, 杠长, 4, 236, 232, 248, 255) }
    若 朝横 == -1 { R.绘矩形(画横 - 2, 画纵 + (玩家边长 - 杠长) / 2, 4, 杠长, 236, 232, 248, 255) }
    若 朝横 == 1 { R.绘矩形(画横 + 玩家边长 - 2, 画纵 + (玩家边长 - 杠长) / 2, 4, 杠长, 236, 232, 248, 255) }
}

函 绘玩家() {
    设 画横 = 场偏横 + 玩家画横() + (格边 - 玩家边长) / 2
    // 画的时候在格内居中；遮挡排序仍按「脚踩格下沿」的底边算，两件事分开
    设 画纵 = 场偏纵 + 玩家底边() - (格边 + 玩家边长) / 2
    R.绘矩形(画横, 画纵, 玩家边长, 玩家边长, 168, 164, 180, 255)
    R.绘矩形(画横, 画纵, 玩家边长, 4, 196, 192, 208, 255)
    R.绘矩形线(画横, 画纵, 玩家边长, 玩家边长, 88, 84, 100, 255)
    绘朝向杠(画横, 画纵)
}

// 对话框：底部一条，空格/回车关掉
// 边框外圈按「辉光」画几层向外发散的描边：近处最亮，往外一层层淡掉
函 绘说框辉光(画纵) {
    若 辉光 <= 0.0 { 返 }
    设 序号 = 1
    当 序号 <= 6 {
        设 外扩像素 = 序号 * 2
        设 层不透明度 = 辉光 * (120 - 序号 * 16)
        若 层不透明度 > 255 { 层不透明度 = 255 }
        若 层不透明度 > 0 {
            R.绘矩形线精((24 - 外扩像素) * 1000, (画纵 - 外扩像素) * 1000, (窗宽 - 48 + 外扩像素 * 2) * 1000, (78 + 外扩像素 * 2) * 1000, 2.0, 255, 255, 255, 整(层不透明度).值)
        }
        序号 = 序号 + 1
    }
}

函 绘说框() {
    设 画纵 = 窗高 - 116
    绘说框辉光(画纵)
    R.绘矩形(24, 画纵, 窗宽 - 48, 78, 10, 9, 14, 235)
    设 边亮 = 整(辉光 * 160).值
    设 边红 = 74 + 边亮
    若 边红 > 255 { 边红 = 255 }
    R.绘矩形线(24, 画纵, 窗宽 - 48, 78, 边红, 边红 - 2, 边红 + 6, 255)
    绘字(说框文, 44, 画纵 + 16, 18, 210, 208, 222, 255)
    绘字("空格 或 回车 关掉", 44, 画纵 + 48, 13, 122, 118, 136, 255)
}

// 菜单：居中标题 + 竖排选项，当前项左侧加一条竖杠
函 绘菜单(标题, 项) {
    R.绘矩形(0, 0, 窗宽, 窗高, 6, 5, 10, 255)
    设 题宽 = 字宽(标题, 30)
    绘字(标题, (窗宽 - 题宽) / 2, 170, 30, 198, 84, 92, 255)
    R.绘矩形((窗宽 - 120) / 2, 220, 120, 2, 88, 84, 96, 255)
    设 序号 = 0
    遍历 项名 于 项 {
        设 名宽 = 字宽(项名, 22)
        设 画横 = (窗宽 - 名宽) / 2
        设 画纵 = 270 + 序号 * 54
        若 序号 == 选目 {
            R.绘矩形(画横 - 22, 画纵 - 10, 3, 34, 190, 76, 84, 255)
            绘字(项名, 画横, 画纵, 22, 232, 228, 240, 255)
        } 否 {
            绘字(项名, 画横, 画纵, 22, 150, 146, 162, 255)
        }
        序号 = 序号 + 1
    }
}

// 鼠标落在哪一项上；不在任何项上返 -1
函 菜单悬(项) {
    设 悬停项 = -1
    设 项号 = 0
    遍历 项名 于 项 {
        若 命中(鼠横, 鼠纵, (窗宽 - 240) / 2, 270 + 项号 * 54 - 10, 240, 34) { 悬停项 = 项号 }
        项号 = 项号 + 1
    }
    返 悬停项
}

// === 主程序 ===
R.初始化窗口(窗宽, 窗高, "图块原型")
// raylib 默认把 ESC 当"请求关窗"，不关掉它，暂停层根本来不及出现就退了
R.设ESC关闭(假)

// 字体要在窗口建好、像素比算出来之后再建
字体 = R.加载字体精准(字体路径, 28 * 像素比, 参考)

当 非 R.窗口应关闭?() {
    设 帧秒 = R.取帧时间()
    鼠横 = R.鼠X()
    鼠纵 = R.鼠Y()
    本帧已开 = 假

    // 辉光按时间线性衰减：500ms 走完就归零
    若 辉光 > 0.0 {
        设 经过毫秒 = 时.毫秒() - 辉光起
        若 经过毫秒 >= 500 { 辉光 = 0.0 }
        若 经过毫秒 < 500 { 辉光 = 1.0 - 经过毫秒 * 1.0 / 500 }
    }

    // ---- 主菜单 ----
    若 场状态 == 0 {
        若 R.键刚按下?(265) 或 R.键刚按下?(87) { 选目 = 选目 - 1 }
        若 R.键刚按下?(264) 或 R.键刚按下?(83) { 选目 = 选目 + 1 }
        若 选目 < 0 { 选目 = 1 }
        若 选目 > 1 { 选目 = 0 }
        设 悬停项 = 菜单悬(主菜单项)
        若 悬停项 >= 0 { 选目 = 悬停项 }
        若 R.键刚按下?(257) {
            若 选目 == 0 { 场状态 = 1 }
            若 选目 == 1 { 退出 = 真 }
        }
        若 R.鼠标刚按下?(0) {
            若 悬停项 >= 0 {
                若 选目 == 0 { 场状态 = 1 }
                若 选目 == 1 { 退出 = 真 }
            }
        }
        若 R.键刚按下?(256) { 退出 = 真 }
    }

    // ---- 世界 ----
    若 场状态 == 1 {
        // 按住 Shift 加速：左右 shift 键码 340 / 344
        当前格秒 = 每格秒
        若 R.键按下?(340) 或 R.键按下?(344) { 当前格秒 = 疾行格秒 }
        若 走中 {
            步已走 = 步已走 + 格边 * 帧秒 * 1.0 / 当前格秒
            若 步已走 >= 格边 {
                玩家格横 = 步起横 + 向横
                玩家格纵 = 步起纵 + 向纵
                走中 = 假
                步已走 = 0.0
                查传送()
            }
        }
        若 非 走中 {
            若 R.键按下?(87) 或 R.键按下?(265) { 起步(0, -1) }
            若 R.键按下?(83) 或 R.键按下?(264) { 起步(0, 1) }
            若 R.键按下?(65) 或 R.键按下?(263) { 起步(-1, 0) }
            若 R.键按下?(68) 或 R.键按下?(262) { 起步(1, 0) }
            若 R.键刚按下?(32) { 调查() }
        }
        若 R.键刚按下?(256) {
            场状态 = 2
            选目 = 0
            本帧已开 = 真
        }
    }

    // ---- 暂停 ----
    若 场状态 == 2 {
        若 R.键刚按下?(265) 或 R.键刚按下?(87) { 选目 = 选目 - 1 }
        若 R.键刚按下?(264) 或 R.键刚按下?(83) { 选目 = 选目 + 1 }
        若 选目 < 0 { 选目 = 2 }
        若 选目 > 2 { 选目 = 0 }
        设 悬停项 = 菜单悬(暂停项)
        若 悬停项 >= 0 { 选目 = 悬停项 }
        若 R.键刚按下?(256) 且 (非 本帧已开) { 场状态 = 1 }
        若 R.键刚按下?(257) {
            若 选目 == 0 { 场状态 = 1 }
            若 选目 == 1 {
                场状态 = 0
                选目 = 0
            }
            若 选目 == 2 { 退出 = 真 }
        }
        若 R.鼠标刚按下?(0) {
            若 悬停项 >= 0 {
                若 选目 == 0 { 场状态 = 1 }
                若 选目 == 1 {
                    场状态 = 0
                    选目 = 0
                }
                若 选目 == 2 { 退出 = 真 }
            }
        }
    }

    // ---- 说框 ----
    若 场状态 == 3 且 非 本帧已开 {
        若 R.键刚按下?(32) 或 R.键刚按下?(257) {
            说框开 = 假
            场状态 = 1
        }
    }
    // 说框挡着动不了：按方向键只让边框亮一下，告诉玩家"人在这儿，是话没读完"
    若 场状态 == 3 {
        设 按了方向 = 假
        若 R.键刚按下?(87) 或 R.键刚按下?(265) { 按了方向 = 真 }
        若 R.键刚按下?(83) 或 R.键刚按下?(264) { 按了方向 = 真 }
        若 R.键刚按下?(65) 或 R.键刚按下?(263) { 按了方向 = 真 }
        若 R.键刚按下?(68) 或 R.键刚按下?(262) { 按了方向 = 真 }
        若 按了方向 {
            辉光 = 1.0
            辉光起 = 时.毫秒()
        }
    }

    // ---- 绘制 ----
    R.开始绘图()
    R.清背景(8, 7, 12, 255)

    若 场状态 == 0 { 绘菜单("图块原型", 主菜单项) }

    若 场状态 >= 1 {
        绘地面()
        绘内墙()
        绘门()
        绘边墙()
        绘远墙()
        绘件分流(真)
        绘玩家()
        绘件分流(假)
        绘近墙()
        绘字("WASD 走 / Shift 快走 / 空格 调查 / ESC 暂停", 20, 40, 14, 120, 118, 132, 255)
    }
    若 场状态 == 2 { 绘菜单("暂停", 暂停项) }
    若 场状态 == 3 { 绘说框() }

    R.结束绘图()

    若 退出 { 断 }
}

R.关闭窗口()

// 图块原型：48 网格的俯视地图，地砖 + 两格高物件 + 朝向 + 空格调查 + 主/暂停菜单
// ============================================================
// 目的：把「一格地板、两格高物件」的三条口径（占位两格、脚在下格、按底边排序）跑起来看效果，
// 并把最小可操作的界面补齐：朝向可辨、能对物件按空格调查、ESC 进暂停层而不是直接退。
// 美术全是色块，等 assets 里进真图再换，引擎不动。
// 操作：WASD/方向键 逐格走，空格 调查面前的东西，空格/回车 关掉对话，
//       ESC 在世界里 = 暂停菜单，在主菜单里 = 直接退出。
// ============================================================

引 "渲染" 予 R
引 "文本" 予 文
外 函 XT_GetRenderWidth(): 整

// === 窗口 ===
设 窗宽 = 800
设 窗高 = 600
设 场偏x = 16
设 场偏y = 96        // 上方留出远墙顶面的空间

// === 读地图数据 ===
设 地图 = 空
设 读果 = 文件.读("原型/地图01.json")
若 读果.成功 == 真 {
    地图 = 解(读果.值)
}
若 地图 == 空 {
    示("地图读不出来：原型/地图01.json")
}

设 格 = 地图["格"]
设 图行 = 地图["行"]
设 图宽 = 地图["宽"]
设 图高 = 地图["高"]
设 物件表 = 地图["物件"]
设 传送表 = 地图["传送"]
若 传送表 == 空 { 传送表 = [] }
设 当前图 = "原型/地图01.json"
// 地图比窗口窄就水平居中，换小图时不会贴左上角
场偏x = (窗宽 - 图宽 * 格) / 2
设 起x = 地图["起点"]["x"]
设 起y = 地图["起点"]["y"]

// === 走位（逐格） ===
设 玩家格x = 起x
设 玩家格y = 起y
设 每格秒 = 0.3
设 走中 = 假
设 向x = 0
设 向y = 0
设 步起x = 0
设 步起y = 0
设 步已走 = 0.0
设 玩家px = 24
设 退出 = 假

// 朝向：单独记，起步时更新；没走过之前默认朝下
设 朝x = 0
设 朝y = 1

// === 界面状态 ===
// 场状态：0=主菜单 1=世界里走 2=暂停菜单 3=说框（照完东西看字）
设 场状态 = 0
设 主菜单项 = ["开始", "退出"]
设 暂停项 = ["继续", "回到主菜单", "退出"]
设 选目 = 0
设 说框文 = ""
设 说框开 = 假
设 鼠横 = 0
设 鼠纵 = 0
// 同一帧里刚用 ESC/空格打开的层，不能被同一个按键立刻关掉
设 本帧已开 = 假
// 说框开着时按方向键 → 边框发白，500ms 内由 100% 淡到 0
设 辉光 = 0.0
设 辉光起 = 0

// === 字体 ===
设 字体 = 0
设 字体路径 = "/System/Library/Fonts/Supplemental/Arial Unicode.ttf"
设 像素比 = 1
若 R.取屏幕宽() > 0 {
    像素比 = XT_GetRenderWidth() / R.取屏幕宽()
}
若 像素比 < 1 { 像素比 = 1 }

// 参考串必须把要画的字全塞进去，漏的字会显示成问号
// 参考串 = 所有会画出来的界面文字 + 每件东西的描述，全部拼进去
设 参考 = "图块原型暂停开始退出继续回到主菜单WASD 走 / 空格 调查 / ESC 暂停空格 或 回车 关掉这里没什么可看的东西柜箱这是一只。"
// 注意：换图后画的描述来自别的 JSON，所以要把「地图集」里每张图的描述全收进来，
// 只收当前这张，换图后会满屏问号。
设 地图集 = 地图["地图集"]
若 地图集 == 空 { 地图集 = ["原型/地图01.json"] }
遍历 路 于 地图集 {
    设 集果 = 文件.读(路)
    若 集果.成功 {
        设 集图 = 解(集果.值)
        遍历 件 于 集图["物件"] {
            若 件["描述"] != 空 { 参考 = 参考 & 件["描述"] }
        }
    }
}

// === 命中 ===
函 命中(x, y, rx, ry, rw, rh) {
    若 x < rx { 返 假 }
    若 x > rx + rw { 返 假 }
    若 y < ry { 返 假 }
    若 y > ry + rh { 返 假 }
    返 真
}

// === 文字 ===
函 绘字(文本, x, y, 号, r, g, b, a) {
    R.绘字体文字(字体, 文本, x, y, 号, 1, r, g, b, a)
}

函 字宽(文本, 号) {
    返 R.量字体文字(字体, 文本, 号, 1)
}

// === 换图 ===
// 传送点是「可走的格子 + 一个到图坐标」；走到那格就载入新图、落到指定格。
函 载地图(路径, 落x, 落y) {
    设 果 = 文件.读(路径)
    若 果.成功 == 假 {
        示("换图失败：" & 路径)
        返 假
    }
    设 新图 = 解(果.值)
    若 新图 == 空 {
        示("换图解析失败：" & 路径)
        返 假
    }
    当前图 = 路径
    地图 = 新图
    格 = 地图["格"]
    图行 = 地图["行"]
    图宽 = 地图["宽"]
    图高 = 地图["高"]
    物件表 = 地图["物件"]
    传送表 = 地图["传送"]
    若 传送表 == 空 { 传送表 = [] }
    场偏x = (窗宽 - 图宽 * 格) / 2
    玩家格x = 落x
    玩家格y = 落y
    走中 = 假
    步已走 = 0.0
    返 真
}

函 查传送() {
    遍历 条 于 传送表 {
        若 条["x"] == 玩家格x 且 条["y"] == 玩家格y {
            载地图(条["到图"], 条["到x"], 条["到y"])
            返 真
        }
    }
    返 假
}

// === 碰撞：墙看地图字符，物件「脚格 + 上半格」两格都挡 ===
// 只挡脚格的话玩家能走进柜子上半格，半个身子埋进去 —— 这是这个原型要证伪的事。
函 被挡(cx, cy) {
    若 cx < 0 或 cy < 0 或 cx >= 图宽 或 cy >= 图高 { 返 真 }
    设 串 = 图行[cy]
    设 列 = 文.字符数组(串)
    若 列[cx] == "#" { 返 真 }
    遍历 件 于 物件表 {
        设 脚x = 件["x"]
        设 脚y = 件["y"]
        若 脚x == cx 且 脚y == cy { 返 真 }
        若 件["高"] == 2 且 脚x == cx 且 脚y - 1 == cy { 返 真 }
    }
    返 假
}

函 起步(dx, dy) {
    // 先转身再看能不能走：贴着墙/柜子按方向键，人不动也要转过去，
    // 否则「脸朝右站在柜子下、想朝上调查」永远做不到。
    朝x = dx
    朝y = dy
    若 被挡(玩家格x + dx, 玩家格y + dy) { 返 }
    向x = dx
    向y = dy
    步起x = 玩家格x
    步起y = 玩家格y
    步已走 = 0.0
    走中 = 真
}

函 玩家位x() {
    若 走中 { 返 步起x * 格 + 向x * 整(步已走).值 }
    返 玩家格x * 格
}

// 底边：脚踩格子下沿；遮挡排序按它比
函 玩家底边() {
    若 走中 { 返 (步起y * 格 + 向y * 整(步已走).值) + 格 }
    返 (玩家格y + 1) * 格
}

函 件底边(件) {
    返 (件["y"] + 1) * 格
}

// === 调查 ===
// 找面前那一格的东西：可能是物件的脚格，也可能是两格高物件的上半格
函 面前件() {
    设 fx = 玩家格x + 朝x
    设 fy = 玩家格y + 朝y
    遍历 件 于 物件表 {
        若 件["x"] == fx 且 件["y"] == fy { 返 件 }
        若 件["高"] == 2 且 件["x"] == fx 且 件["y"] - 1 == fy { 返 件 }
    }
    返 空
}

函 调查() {
    设 件 = 面前件()
    若 件 != 空 {
        设 文句 = 件["描述"]
        若 文句 == 空 { 文句 = "这是一只" & 件["图"] & "。" }
        说框文 = 文句
    } 否 {
        说框文 = "这里没什么可看的东西。"
    }
    说框开 = 真
    场状态 = 3
    本帧已开 = 真
}

// === 绘制 ===
函 绘地面() {
    设 cy = 0
    当 cy < 图高 {
        设 cx = 0
        当 cx < 图宽 {
            设 串 = 图行[cy]
            设 列 = 文.字符数组(串)
            若 列[cx] != "#" {
                设 基 = 34
                若 (cx + cy) % 2 == 0 { 基 = 38 }
                R.绘矩形(场偏x + cx * 格, 场偏y + cy * 格, 格, 格, 基, 基 - 2, 基 + 8, 255)
                R.绘矩形(场偏x + cx * 格, 场偏y + cy * 格, 格, 1, 基 + 8, 基 + 6, 基 + 16, 255)
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
}

// 传送点画在格子里：一圈亮边 + 中间一道缝，走进去就知道是门
函 绘门() {
    遍历 条 于 传送表 {
        设 x = 场偏x + 条["x"] * 格
        设 y = 场偏y + 条["y"] * 格
        R.绘矩形线(x + 2, y + 2, 格 - 4, 格 - 4, 176, 150, 84, 255)
        R.绘矩形(x + 格 / 2 - 1, y + 6, 2, 格 - 12, 120, 102, 58, 255)
    }
}

// 远墙：正面 + 顶面（斜俯视里上半屏的墙能看见这两截）
函 绘远墙() {
    设 cx = 0
    当 cx < 图宽 {
        设 串 = 图行[0]
        设 列 = 文.字符数组(串)
        若 列[cx] == "#" {
            设 x = 场偏x + cx * 格
            设 y = 场偏y
            R.绘矩形(x, y, 格, 格, 26, 24, 32, 255)
            R.绘三角(x, y, x + 格, y, x + 格 - 6, y - 14, 58, 54, 66, 255)
            R.绘三角(x, y, x + 格 - 6, y - 14, x + 6, y - 14, 58, 54, 66, 255)
        }
        cx = cx + 1
    }
}

// 近墙：只剩一条棱
函 绘近墙() {
    设 cx = 0
    当 cx < 图宽 {
        设 串 = 图行[图高 - 1]
        设 列 = 文.字符数组(串)
        若 列[cx] == "#" {
            设 x = 场偏x + cx * 格
            设 y = 场偏y + (图高 - 1) * 格
            R.绘矩形(x, y, 格, 12, 44, 41, 51, 255)
            R.绘矩形(x, y, 格, 2, 62, 58, 70, 255)
        }
        cx = cx + 1
    }
}

函 绘边墙() {
    设 cy = 1
    当 cy < 图高 - 1 {
        R.绘矩形(场偏x, 场偏y + cy * 格, 格, 格, 24, 22, 30, 255)
        设 xr = 场偏x + (图宽 - 1) * 格
        R.绘矩形(xr, 场偏y + cy * 格, 格, 格, 24, 22, 30, 255)
        cy = cy + 1
    }
}

函 绘件(件) {
    设 wx = 场偏x + 件["x"] * 格
    设 底 = 场偏y + (件["y"] + 1) * 格
    设 高 = 件["高"] * 格
    设 顶 = 底 - 高
    若 件["图"] == "柜" {
        R.绘矩形(wx, 顶, 格, 高, 74, 58, 44, 255)
        R.绘矩形(wx, 顶, 格, 3, 96, 78, 60, 255)
        R.绘矩形(wx + 6, 顶 + 12, 格 - 12, 2, 58, 45, 35, 255)
        R.绘矩形线(wx, 顶, 格, 高, 40, 32, 25, 255)
    }
    若 件["图"] == "箱" {
        R.绘矩形(wx, 顶, 格, 高, 62, 50, 38, 255)
        R.绘矩形线(wx, 顶, 格, 高, 38, 30, 22, 255)
    }
    R.绘三角(wx, 顶, wx + 格, 顶, wx + 格 - 6, 顶 - 10, 104, 84, 64, 255)
    R.绘三角(wx, 顶, wx + 格 - 6, 顶 - 10, wx + 6, 顶 - 10, 104, 84, 64, 255)
}

// 按底边分流：比玩家小的先画（会被玩家盖住），大的后画（盖住玩家）
函 绘件分流(较小) {
    遍历 件 于 物件表 {
        设 该小 = 件底边(件) <= 玩家底边()
        若 较小 且 该小 { 绘件(件) }
        若 (非 较小) 且 (非 该小) { 绘件(件) }
    }
}

// 朝向用方块内一条贴边的短杠表示：朝哪边，杠就贴哪条边
函 绘朝向杠(x, y) {
    设 长 = 12
    若 朝x == 0 且 朝y == -1 { R.绘矩形(x + (玩家px - 长) / 2, y - 2, 长, 4, 236, 232, 248, 255) }
    若 朝x == 0 且 朝y == 1 { R.绘矩形(x + (玩家px - 长) / 2, y + 玩家px - 2, 长, 4, 236, 232, 248, 255) }
    若 朝x == -1 { R.绘矩形(x - 2, y + (玩家px - 长) / 2, 4, 长, 236, 232, 248, 255) }
    若 朝x == 1 { R.绘矩形(x + 玩家px - 2, y + (玩家px - 长) / 2, 4, 长, 236, 232, 248, 255) }
}

函 绘玩家() {
    设 x = 场偏x + 玩家位x() + (格 - 玩家px) / 2
    // 画的时候在格内居中；遮挡排序仍按「脚踩格下沿」的底边算，两件事分开
    设 y = 场偏y + 玩家底边() - (格 + 玩家px) / 2
    R.绘矩形(x, y, 玩家px, 玩家px, 168, 164, 180, 255)
    R.绘矩形(x, y, 玩家px, 4, 196, 192, 208, 255)
    R.绘矩形线(x, y, 玩家px, 玩家px, 88, 84, 100, 255)
    绘朝向杠(x, y)
}

// 对话框：底部一条，空格/回车关掉
// 边框外圈按「辉光」画几层向外发散的描边：近处最亮，往外一层层淡掉
函 绘说框辉光(y) {
    若 辉光 <= 0.0 { 返 }
    设 i = 1
    当 i <= 6 {
        设 扩 = i * 2
        设 强 = 辉光 * (120 - i * 16)
        若 强 > 255 { 强 = 255 }
        若 强 > 0 {
            R.绘矩形线精((24 - 扩) * 1000, (y - 扩) * 1000, (窗宽 - 48 + 扩 * 2) * 1000, (78 + 扩 * 2) * 1000, 2.0, 255, 255, 255, 整(强).值)
        }
        i = i + 1
    }
}

函 绘说框() {
    设 y = 窗高 - 116
    绘说框辉光(y)
    R.绘矩形(24, y, 窗宽 - 48, 78, 10, 9, 14, 235)
    设 边亮 = 整(辉光 * 160).值
    设 br = 74 + 边亮
    若 br > 255 { br = 255 }
    R.绘矩形线(24, y, 窗宽 - 48, 78, br, br - 2, br + 6, 255)
    绘字(说框文, 44, y + 16, 18, 210, 208, 222, 255)
    绘字("空格 或 回车 关掉", 44, y + 48, 13, 122, 118, 136, 255)
}

// 菜单：居中标题 + 竖排选项，当前项左侧加一条竖杠
函 绘菜单(标题, 项) {
    R.绘矩形(0, 0, 窗宽, 窗高, 6, 5, 10, 255)
    设 宽 = 字宽(标题, 30)
    绘字(标题, (窗宽 - 宽) / 2, 170, 30, 198, 84, 92, 255)
    R.绘矩形((窗宽 - 120) / 2, 220, 120, 2, 88, 84, 96, 255)
    设 i = 0
    遍历 名 于 项 {
        设 w = 字宽(名, 22)
        设 x = (窗宽 - w) / 2
        设 y = 270 + i * 54
        若 i == 选目 {
            R.绘矩形(x - 22, y - 10, 3, 34, 190, 76, 84, 255)
            绘字(名, x, y, 22, 232, 228, 240, 255)
        } 否 {
            绘字(名, x, y, 22, 150, 146, 162, 255)
        }
        i = i + 1
    }
}

// 鼠标落在哪一项上；不在任何项上返 -1
函 菜单悬(项) {
    设 悬 = -1
    设 j = 0
    遍历 名 于 项 {
        若 命中(鼠横, 鼠纵, (窗宽 - 240) / 2, 270 + j * 54 - 10, 240, 34) { 悬 = j }
        j = j + 1
    }
    返 悬
}

// === 主程序 ===
R.初始化窗口(窗宽, 窗高, "图块原型")
// raylib 默认把 ESC 当"请求关窗"，不关掉它，暂停层根本来不及出现就退了
R.设ESC关闭(假)

// 字体要在窗口建好、像素比算出来之后再建
字体 = R.加载字体精准(字体路径, 28 * 像素比, 参考)

当 非 R.窗口应关闭?() {
    设 dt = R.取帧时间()
    鼠横 = R.鼠X()
    鼠纵 = R.鼠Y()
    本帧已开 = 假

    // 辉光按时间线性衰减：500ms 走完就归零
    若 辉光 > 0.0 {
        设 过 = 时.毫秒() - 辉光起
        若 过 >= 500 { 辉光 = 0.0 }
        若 过 < 500 { 辉光 = 1.0 - 过 * 1.0 / 500 }
    }

    // ---- 主菜单 ----
    若 场状态 == 0 {
        若 R.键刚按下?(265) 或 R.键刚按下?(87) { 选目 = 选目 - 1 }
        若 R.键刚按下?(264) 或 R.键刚按下?(83) { 选目 = 选目 + 1 }
        若 选目 < 0 { 选目 = 1 }
        若 选目 > 1 { 选目 = 0 }
        设 悬 = 菜单悬(主菜单项)
        若 悬 >= 0 { 选目 = 悬 }
        若 R.键刚按下?(257) {
            若 选目 == 0 { 场状态 = 1 }
            若 选目 == 1 { 退出 = 真 }
        }
        若 R.鼠标刚按下?(0) {
            若 悬 >= 0 {
                若 选目 == 0 { 场状态 = 1 }
                若 选目 == 1 { 退出 = 真 }
            }
        }
        若 R.键刚按下?(256) { 退出 = 真 }
    }

    // ---- 世界 ----
    若 场状态 == 1 {
        若 走中 {
            步已走 = 步已走 + 格 * dt * 1.0 / 每格秒
            若 步已走 >= 格 {
                玩家格x = 步起x + 向x
                玩家格y = 步起y + 向y
                走中 = 假
                步已走 = 0.0
                查传送()
            }
        }
        若 非 走中 {
            若 R.键按下?(87) 或 R.键按下?(265) { 起步(0, -1) }
            若 R.键按下?(83) 或 R.键按下?(264) { 起步(0, 1) }
            若 R.键按下?(65) 或 R.键按下?(263) { 起步(-1, 0) }
            若 R.键按下?(68) 或 R.键按下?(262) { 起步(1, 0) }
            若 R.键刚按下?(32) { 调查() }
        }
        若 R.键刚按下?(256) {
            场状态 = 2
            选目 = 0
            本帧已开 = 真
        }
    }

    // ---- 暂停 ----
    若 场状态 == 2 {
        若 R.键刚按下?(265) 或 R.键刚按下?(87) { 选目 = 选目 - 1 }
        若 R.键刚按下?(264) 或 R.键刚按下?(83) { 选目 = 选目 + 1 }
        若 选目 < 0 { 选目 = 2 }
        若 选目 > 2 { 选目 = 0 }
        设 悬 = 菜单悬(暂停项)
        若 悬 >= 0 { 选目 = 悬 }
        若 R.键刚按下?(256) 且 (非 本帧已开) { 场状态 = 1 }
        若 R.键刚按下?(257) {
            若 选目 == 0 { 场状态 = 1 }
            若 选目 == 1 {
                场状态 = 0
                选目 = 0
            }
            若 选目 == 2 { 退出 = 真 }
        }
        若 R.鼠标刚按下?(0) {
            若 悬 >= 0 {
                若 选目 == 0 { 场状态 = 1 }
                若 选目 == 1 {
                    场状态 = 0
                    选目 = 0
                }
                若 选目 == 2 { 退出 = 真 }
            }
        }
    }

    // ---- 说框 ----
    若 场状态 == 3 且 非 本帧已开 {
        若 R.键刚按下?(32) 或 R.键刚按下?(257) {
            说框开 = 假
            场状态 = 1
        }
    }
    // 说框挡着动不了：按方向键只让边框亮一下，告诉玩家"人在这儿，是话没读完"
    若 场状态 == 3 {
        设 推了 = 假
        若 R.键刚按下?(87) 或 R.键刚按下?(265) { 推了 = 真 }
        若 R.键刚按下?(83) 或 R.键刚按下?(264) { 推了 = 真 }
        若 R.键刚按下?(65) 或 R.键刚按下?(263) { 推了 = 真 }
        若 R.键刚按下?(68) 或 R.键刚按下?(262) { 推了 = 真 }
        若 推了 {
            辉光 = 1.0
            辉光起 = 时.毫秒()
        }
    }

    // ---- 绘制 ----
    R.开始绘图()
    R.清背景(8, 7, 12, 255)

    若 场状态 == 0 { 绘菜单("图块原型", 主菜单项) }

    若 场状态 >= 1 {
        绘地面()
        绘门()
        绘边墙()
        绘远墙()
        绘件分流(真)
        绘玩家()
        绘件分流(假)
        绘近墙()
        绘字("WASD 走 / 空格 调查 / ESC 暂停", 20, 40, 14, 120, 118, 132, 255)
    }
    若 场状态 == 2 { 绘菜单("暂停", 暂停项) }
    若 场状态 == 3 { 绘说框() }

    R.结束绘图()

    若 退出 { 断 }
}

R.关闭窗口()

// 主函数.xt — 无尽回廊 · 玄铁最小垂直切片
// ============================================================
// 目标：验证「玄铁语言 + 渲染库」在 macOS 上的完整链路：
//       窗口 → 输入 → 绘制 → 黑暗氛围 → 正常退出。
// 操作：WASD / 方向键移动，ESC 退出。
//
// 已知坑（玄铁 1.0-rc 实测）：
//   - 可执行产物名若与源码文本（源文件名/注释/标题）中的字样重名
//     （如“主函数”“无尽回廊”），启动即崩（glfwInit → CFBundle）。
//     因此本程序构建产物统一命名为 corridor（scripts/build-macos.rvs）。
// ============================================================

引 "渲染" 予 R

// === 常量 ===
设 窗口宽 = 800
设 窗口高 = 600
设 玩家大小 = 28
设 移动速度 = 4   // 像素/帧（60fps 下约 240px/s；用整型步长避免小数混入坐标）

// === 全局状态 ===
设 玩家x = 386
设 玩家y = 286

// === 绘制：屏幕四边暗角（恐怖氛围雏形） ===
函 绘制暗角() {
    // 左
    R.绘矩形(0, 0, 70, 窗口高, 0, 0, 0, 55)
    R.绘矩形(0, 0, 34, 窗口高, 0, 0, 0, 65)
    R.绘矩形(0, 0, 12, 窗口高, 0, 0, 0, 80)
    // 右
    R.绘矩形(窗口宽 - 70, 0, 70, 窗口高, 0, 0, 0, 55)
    R.绘矩形(窗口宽 - 34, 0, 34, 窗口高, 0, 0, 0, 65)
    R.绘矩形(窗口宽 - 12, 0, 12, 窗口高, 0, 0, 0, 80)
    // 上
    R.绘矩形(0, 0, 窗口宽, 70, 0, 0, 0, 55)
    R.绘矩形(0, 0, 窗口宽, 34, 0, 0, 0, 65)
    R.绘矩形(0, 0, 窗口宽, 12, 0, 0, 0, 80)
    // 下
    R.绘矩形(0, 窗口高 - 70, 窗口宽, 70, 0, 0, 0, 55)
    R.绘矩形(0, 窗口高 - 34, 窗口宽, 34, 0, 0, 0, 65)
    R.绘矩形(0, 窗口高 - 12, 窗口宽, 12, 0, 0, 0, 80)
}

// === 绘制：手电筒光圈（整屏压暗，玩家周围叠亮色圆） ===
函 绘制光照() {
    R.绘矩形(0, 0, 窗口宽, 窗口高, 0, 0, 0, 185)
    设 cx = 玩家x + 玩家大小 / 2
    设 cy = 玩家y + 玩家大小 / 2
    R.绘圆(cx, cy, 215, 27, 25, 35, 55)
    R.绘圆(cx, cy, 150, 31, 29, 41, 85)
    R.绘圆(cx, cy, 95, 37, 35, 49, 120)
    R.绘圆(cx, cy, 48, 45, 43, 59, 150)
}

// === 绘制：极淡的地砖网格线（走廊地板感） ===
函 绘制地板() {
    设 g = 0
    当 g <= 窗口宽 {
        R.绘直线(g, 0, g, 窗口高, 255, 255, 255, 6)
        g = g + 100
    }
    设 h = 0
    当 h <= 窗口高 {
        R.绘直线(0, h, 窗口宽, h, 255, 255, 255, 6)
        h = h + 100
    }
}

// === 主程序 ===
R.初始化窗口(窗口宽, 窗口高, "无尽回廊 · 玄铁切片")
R.设ESC关闭(真)

当 非 R.窗口应关闭?() {
    设 步长 = 移动速度

    // 移动：WASD / 方向键
    若 R.键按下?(87) 或 R.键按下?(265) { 玩家y = 玩家y - 步长 }   // W / 上
    若 R.键按下?(83) 或 R.键按下?(264) { 玩家y = 玩家y + 步长 }   // S / 下
    若 R.键按下?(65) 或 R.键按下?(263) { 玩家x = 玩家x - 步长 }   // A / 左
    若 R.键按下?(68) 或 R.键按下?(262) { 玩家x = 玩家x + 步长 }   // D / 右

    // 边界限制
    若 玩家x < 0 { 玩家x = 0 }
    若 玩家x > 窗口宽 - 玩家大小 { 玩家x = 窗口宽 - 玩家大小 }
    若 玩家y < 0 { 玩家y = 0 }
    若 玩家y > 窗口高 - 玩家大小 { 玩家y = 窗口高 - 玩家大小 }

    // 渲染一帧
    R.开始绘图()
    R.清背景(10, 9, 14, 255)   // 暗色底

    绘制地板()
    // 玩家（灰白方块 + 描边）
    R.绘矩形(玩家x, 玩家y, 玩家大小, 玩家大小, 188, 188, 204, 255)
    R.绘矩形线(玩家x - 1, 玩家y - 1, 玩家大小 + 2, 玩家大小 + 2, 130, 130, 150, 255)

    绘制暗角()
    绘制光照()

    R.结束绘图()
}

R.关闭窗口()
示("玄铁切片运行结束")

// 主函数.xt — 无尽回廊 · 玄铁框架骨架 v0.2
// ============================================================
// 在最小垂直切片（窗口+移动+暗角+光照）之上搭建游戏框架：
//   状态机（开始→游玩→暂停） + 网格地图与碰撞 + 玩家 + 渲染分层。
// 后续功能（怪物/物品/对话/音效/存档）沿此骨架逐块填充。
//
// 操作：回车=开始；WASD/方向键=移动；ESC=暂停/继续。
//
// 已知限制（玄铁 1.0-rc）：
//   - HiDPI/Retina 未适配：逻辑分辨率 800x600，高分屏可能模糊（上游未决策）
//   - 产物名避开源码字样（corridor 规避见 AGENTS.md）
// ============================================================

引 "渲染" 予 R

// === 常量 ===
设 窗口宽 = 800
设 窗口高 = 600
设 格大小 = 40
设 地图宽 = 20
设 地图高 = 15
设 玩家大小 = 24
设 移动速度 = 4

// === 全局状态 ===
设 阶段 = 0        // 0=开始画面 1=游玩 2=暂停
设 玩家x = 388
设 玩家y = 288
设 地图数据 = []   // 一维数组：0=空地 1=墙（索引 = 行*地图宽 + 列）

// === 地图：造地图（四周墙 + 内部走廊隔断，留缺口） ===
函 造地图() {
    设 i = 0
    当 i < 地图宽 * 地图高 {
        设 是墙 = 假
        设 列 = i % 地图宽
        若 i < 地图宽 { 是墙 = 真 }                  // 上边界
        若 i >= (地图高 - 1) * 地图宽 { 是墙 = 真 }   // 下边界
        若 列 == 0 { 是墙 = 真 }                     // 左边界
        若 列 == 地图宽 - 1 { 是墙 = 真 }            // 右边界
        // 内部隔断：行 3、7、11 加横墙，每段留 3 格门洞
        若 i >= 3 * 地图宽 且 i < 4 * 地图宽 { 若 列 < 4 或 列 > 地图宽 - 5 { 是墙 = 真 } }
        若 i >= 7 * 地图宽 且 i < 8 * 地图宽 { 若 列 < 4 或 列 > 地图宽 - 5 { 是墙 = 真 } }
        若 i >= 11 * 地图宽 且 i < 12 * 地图宽 { 若 列 < 4 或 列 > 地图宽 - 5 { 是墙 = 真 } }
        若 是墙 { 地图数据.追加(1) }
        若 非 是墙 { 地图数据.追加(0) }
        i = i + 1
    }
}

// === 碰撞：给定玩家左上角坐标，四角查格是否撞墙 ===
函 撞墙?(nx, ny) {
    设 撞上 = 假
    设 左 = nx / 格大小
    设 右 = (nx + 玩家大小 - 1) / 格大小
    设 上 = ny / 格大小
    设 下 = (ny + 玩家大小 - 1) / 格大小
    若 地图数据[上 * 地图宽 + 左] == 1 { 撞上 = 真 }
    若 地图数据[上 * 地图宽 + 右] == 1 { 撞上 = 真 }
    若 地图数据[下 * 地图宽 + 左] == 1 { 撞上 = 真 }
    若 地图数据[下 * 地图宽 + 右] == 1 { 撞上 = 真 }
    返 撞上
}

// === 更新：游玩（移动 + 碰撞 + 边界） ===
函 更新游玩() {
    设 步长 = 移动速度
    若 R.键按下?(87) 或 R.键按下?(265) {
        设 ny = 玩家y - 步长
        若 非 撞墙?(玩家x, ny) { 玩家y = ny }
    }
    若 R.键按下?(83) 或 R.键按下?(264) {
        设 ny = 玩家y + 步长
        若 非 撞墙?(玩家x, ny) { 玩家y = ny }
    }
    若 R.键按下?(65) 或 R.键按下?(263) {
        设 nx = 玩家x - 步长
        若 非 撞墙?(nx, 玩家y) { 玩家x = nx }
    }
    若 R.键按下?(68) 或 R.键按下?(262) {
        设 nx = 玩家x + 步长
        若 非 撞墙?(nx, 玩家y) { 玩家x = nx }
    }
    // 窗口边界兜底
    若 玩家x < 0 { 玩家x = 0 }
    若 玩家x > 窗口宽 - 玩家大小 { 玩家x = 窗口宽 - 玩家大小 }
    若 玩家y < 0 { 玩家y = 0 }
    若 玩家y > 窗口高 - 玩家大小 { 玩家y = 窗口高 - 玩家大小 }
}

// === 渲染：地图（墙=暗块 空地=地板格） ===
函 绘地图() {
    设 i = 0
    当 i < 地图宽 * 地图高 {
        设 列 = i % 地图宽
        设 行 = i / 地图宽
        设 px = 列 * 格大小
        设 py = 行 * 格大小
        若 地图数据[i] == 1 {
            R.绘矩形(px, py, 格大小, 格大小, 34, 32, 44, 255)
            R.绘矩形线(px, py, 格大小, 格大小, 50, 48, 62, 255)
        }
        若 地图数据[i] == 0 {
            R.绘矩形(px, py, 格大小, 格大小, 24, 23, 32, 255)
            R.绘矩形线(px, py, 格大小, 格大小, 34, 33, 46, 255)
        }
        i = i + 1
    }
}

// === 渲染：玩家 ===
函 绘玩家() {
    R.绘矩形(玩家x, 玩家y, 玩家大小, 玩家大小, 188, 188, 204, 255)
    R.绘矩形线(玩家x - 1, 玩家y - 1, 玩家大小 + 2, 玩家大小 + 2, 130, 130, 150, 255)
}

// === 渲染：四边暗角（多层平滑渐暗，无硬边锯齿） ===
函 绘暗角() {
    // 左/右：5 层渐宽矩形，alpha 逐层加深
    R.绘矩形(0, 0, 90, 窗口高, 0, 0, 0, 26)
    R.绘矩形(0, 0, 72, 窗口高, 0, 0, 0, 38)
    R.绘矩形(0, 0, 54, 窗口高, 0, 0, 0, 50)
    R.绘矩形(0, 0, 36, 窗口高, 0, 0, 0, 62)
    R.绘矩形(0, 0, 18, 窗口高, 0, 0, 0, 74)
    R.绘矩形(窗口宽 - 90, 0, 90, 窗口高, 0, 0, 0, 26)
    R.绘矩形(窗口宽 - 72, 0, 72, 窗口高, 0, 0, 0, 38)
    R.绘矩形(窗口宽 - 54, 0, 54, 窗口高, 0, 0, 0, 50)
    R.绘矩形(窗口宽 - 36, 0, 36, 窗口高, 0, 0, 0, 62)
    R.绘矩形(窗口宽 - 18, 0, 18, 窗口高, 0, 0, 0, 74)
    // 上/下
    R.绘矩形(0, 0, 窗口宽, 90, 0, 0, 0, 26)
    R.绘矩形(0, 0, 窗口宽, 72, 0, 0, 0, 38)
    R.绘矩形(0, 0, 窗口宽, 54, 0, 0, 0, 50)
    R.绘矩形(0, 0, 窗口宽, 36, 0, 0, 0, 62)
    R.绘矩形(0, 0, 窗口宽, 18, 0, 0, 0, 74)
    R.绘矩形(0, 窗口高 - 90, 窗口宽, 90, 0, 0, 0, 26)
    R.绘矩形(0, 窗口高 - 72, 窗口宽, 72, 0, 0, 0, 38)
    R.绘矩形(0, 窗口高 - 54, 窗口宽, 54, 0, 0, 0, 50)
    R.绘矩形(0, 窗口高 - 36, 窗口宽, 36, 0, 0, 0, 62)
    R.绘矩形(0, 窗口高 - 18, 窗口宽, 18, 0, 0, 0, 74)
}

// === 渲染：玩家周围光晕（亮色同心圆叠加，无混合模式下的近似手电筒） ===
函 绘光照() {
    设 cx = 玩家x + 玩家大小 / 2
    设 cy = 玩家y + 玩家大小 / 2
    R.绘圆(cx, cy, 215, 96, 94, 116, 12)
    R.绘圆(cx, cy, 160, 110, 108, 130, 20)
    R.绘圆(cx, cy, 105, 126, 124, 146, 30)
    R.绘圆(cx, cy, 55, 144, 142, 164, 42)
}

// === 渲染：游戏画面（地图→玩家→暗角→光照） ===
函 绘游戏画面() {
    绘地图()
    绘玩家()
    绘暗角()
    绘光照()
}

// === 更新：开始画面（回车进入游玩） ===
函 更新开始() {
    若 R.键按下?(257) { 阶段 = 1 }
}

// === 更新：暂停（ESC 恢复） ===
函 更新暂停() {
    若 R.键按下?(256) { 阶段 = 1 }
}

// === 更新：游玩（ESC 暂停） ===
函 更新暂停键() {
    若 R.键按下?(256) { 阶段 = 2 }
}

// === 渲染：开始画面 ===
函 绘开始画面() {
    R.绘矩形(0, 0, 窗口宽, 窗口高, 6, 5, 10, 255)
    R.绘文字("THE ENDLESS CORRIDOR", 190, 250, 36, 200, 200, 214, 255)
    R.绘文字("PRESS ENTER TO START", 255, 320, 20, 130, 130, 150, 255)
}

// === 主程序 ===
R.初始化窗口(窗口宽, 窗口高, "无尽回廊")
R.设ESC关闭(假)
造地图()

当 非 R.窗口应关闭?() {
    // 更新阶段
    若 阶段 == 0 { 更新开始() }
    若 阶段 == 1 { 更新游玩() }
    若 阶段 == 1 { 更新暂停键() }
    若 阶段 == 2 { 更新暂停() }

    // 渲染一帧
    R.开始绘图()
    R.清背景(10, 9, 14, 255)
    若 阶段 == 0 { 绘开始画面() }
    若 阶段 == 1 { 绘游戏画面() }
    若 阶段 == 2 { 绘游戏画面() }
    R.结束绘图()
}

R.关闭窗口()
示("无尽回廊框架运行结束")

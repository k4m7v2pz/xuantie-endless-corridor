// 主函数.xt — 无尽回廊 · 第一幕「走廊尽头」可操控版
// ============================================================
// 从纯文本原型走到 2D：横向走廊、可走、墙上有划痕、走到铁门触发便条与转盘锁。
// 剧情文字仍然来自 剧情/幕01.json 的同一份内容（这里先内联，后续接 JSON）。
//
// 操作：回车=开始；WASD/方向键=移动；走到铁门自动停下；数字键=拨转盘；回车=确认。
// ============================================================

引 "渲染" 予 R

// === 常量 ===
设 窗口宽 = 800
设 窗口高 = 600
设 通道上 = 150
设 通道下 = 470
设 玩家大小 = 24
设 速度 = 3
设 门x = 660

// === 全局状态 ===
设 阶段 = 0        // 0=开始 1=走 2=便条 3=转盘锁 4=门开 5=结束
设 玩家x = 60
设 玩家y = 310
设 答案 = ""
设 字体 = 0
设 看门次数 = 0
设 撬过 = 假
设 退出 = 假

// === 剧情文本（与 剧情/幕01.json 一致） ===
设 文一 = "走廊只有一米二宽。手电筒的光，在三米外就散成了雾。"
设 文二 = "左边墙上有一排粉笔划的正字，划痕很新，白得刺眼。"
设 文三 = "尽头是一扇铁门。没有把手，只有一个四位数的转盘锁。"
设 便条 = "门上贴着一张便条，纸边都卷了：按你数到的数。"
设 引子 = "便条只写了这一句。你想起走廊墙上那排划痕。"
设 撬白 = "你把手电筒塞进锁孔旁的缝里，用力一撬。门轴发出很响的一声，门开了。"
设 错白 = "转盘空转。门外那排划痕在光里晃了一下。"
设 对白 = "转盘咬合一下，门开了。门后没有声音。"
设 提示 = "数字键拨四位，回车确认；按 Q 放弃。"
设 参考 = 文一 & 文二 & 文三 & 便条 & 引子 & 错白 & 对白 & 撬白 & 提示 & "（）按回车开始走近继续门后是段更长的走廊第一幕到此结束退出无尽回廊走动到铁门前输入数字键拨四位确认放弃Q_0123456789第"

// === 文字（中文字体，按参考文本精准取字） ===
函 绘中(文本, x, y, 号, r, g, b, a) {
    R.绘字体文字(字体, 文本, x, y, 号, 1, r, g, b, a)
}

// === 更新：移动 ===
函 更新走() {
    设 步 = 速度
    若 R.键按下?(87) 或 R.键按下?(265) {
        设 ny = 玩家y - 步
        若 ny >= 通道上 + 2 { 玩家y = ny }
    }
    若 R.键按下?(83) 或 R.键按下?(264) {
        设 ny = 玩家y + 步
        若 ny <= 通道下 - 玩家大小 - 2 { 玩家y = ny }
    }
    若 R.键按下?(65) 或 R.键按下?(263) {
        设 nx = 玩家x - 步
        若 nx >= 40 { 玩家x = nx }
    }
    若 R.键按下?(68) 或 R.键按下?(262) {
        设 nx = 玩家x + 步
        若 nx <= 门x - 玩家大小 - 4 { 玩家x = nx }
    }
    若 玩家x >= 门x - 玩家大小 - 6 {
        阶段 = 2
    }
}

// === 更新：数字输入 ===
函 更新锁() {
    若 R.键刚按下?(48) { 若 答案.长度 < 4 { 答案 = 答案 & "0" } }
    若 R.键刚按下?(49) { 若 答案.长度 < 4 { 答案 = 答案 & "1" } }
    若 R.键刚按下?(50) { 若 答案.长度 < 4 { 答案 = 答案 & "2" } }
    若 R.键刚按下?(51) { 若 答案.长度 < 4 { 答案 = 答案 & "3" } }
    若 R.键刚按下?(52) { 若 答案.长度 < 4 { 答案 = 答案 & "4" } }
    若 R.键刚按下?(53) { 若 答案.长度 < 4 { 答案 = 答案 & "5" } }
    若 R.键刚按下?(54) { 若 答案.长度 < 4 { 答案 = 答案 & "6" } }
    若 R.键刚按下?(55) { 若 答案.长度 < 4 { 答案 = 答案 & "7" } }
    若 R.键刚按下?(56) { 若 答案.长度 < 4 { 答案 = 答案 & "8" } }
    若 R.键刚按下?(57) { 若 答案.长度 < 4 { 答案 = 答案 & "9" } }
    若 R.键刚按下?(259) { 若 答案.长度 > 0 { 答案 = 答案[0..答案.长度 - 1] } }
    若 R.键刚按下?(81) { 撬过 = 真 }
    若 撬过 { 阶段 = 4 }
    若 R.键刚按下?(257) {
        设 行 = 假
        若 答案 == "0027" { 行 = 真 }
        若 答案 == "27" { 行 = 真 }
        若 答案 == "27.0" { 行 = 假 }
        若 行 {
            阶段 = 4
        } 否 {
            看门次数 = 看门次数 + 1
            答案 = ""
        }
    }
}

// === 绘制：场景 ===
函 绘场景() {
    // 地板
    R.绘矩形(0, 通道上, 窗口宽, 通道下 - 通道上, 38, 36, 48, 255)
    // 上下墙
    R.绘矩形(0, 0, 窗口宽, 通道上, 16, 15, 22, 255)
    R.绘矩形(0, 通道下, 窗口宽, 窗口高 - 通道下, 16, 15, 22, 255)
    // 墙上 27 道粉笔划痕
    设 i = 0
    当 i < 27 {
        R.绘直线(90 + i * 20, 126, 90 + i * 20, 146, 232, 230, 214, 210)
        i = i + 1
    }
    // 铁门
    R.绘矩形(门x, 通道上, 30, 通道下 - 通道上, 52, 48, 44, 255)
    R.绘矩形线(门x, 通道上, 30, 通道下 - 通道上, 88, 82, 74, 255)
    // 转盘
    R.绘圆(门x + 15, 310, 12, 96, 90, 82, 255)
    // 玩家
    R.绘矩形(玩家x, 玩家y, 玩家大小, 玩家大小, 188, 188, 204, 255)
    R.绘矩形线(玩家x - 1, 玩家y - 1, 玩家大小 + 2, 玩家大小 + 2, 130, 130, 150, 255)
    // 光照
    设 cx = 玩家x + 12
    设 cy = 玩家y + 12
    R.绘圆(cx, cy, 170, 96, 94, 116, 12)
    R.绘圆(cx, cy, 120, 108, 106, 128, 20)
    R.绘圆(cx, cy, 76, 124, 122, 144, 30)
    R.绘圆(cx, cy, 40, 140, 138, 160, 42)
}

// === 绘制：文字框 ===
函 绘框二(行一, 行二, y, 高) {
    R.绘矩形(40, y - 10, 窗口宽 - 80, 高, 8, 8, 12, 230)
    R.绘矩形线(40, y - 10, 窗口宽 - 80, 高, 70, 68, 84, 255)
    绘中(行一, 60, y, 22, 226, 224, 232, 255)
    绘中(行二, 60, y + 30, 18, 170, 168, 184, 255)
}

函 补位(文本) {
    设 结 = 文本
    当 结.长度 < 4 { 结 = 结 & "_" }
    返 结
}

函 绘框(文本, y, 高) {
    R.绘矩形(40, y - 10, 窗口宽 - 80, 高, 8, 8, 12, 230)
    R.绘矩形线(40, y - 10, 窗口宽 - 80, 高, 70, 68, 84, 255)
    绘中(文本, 60, y, 22, 226, 224, 232, 255)
}

// === 主程序 ===
R.初始化窗口(窗口宽, 窗口高, "无尽回廊")
R.设ESC关闭(假)
R.设置目标帧率(60)
字体 = R.加载字体精准("/System/Library/Fonts/Supplemental/Arial Unicode.ttf", 24, 参考)

当 非 R.窗口应关闭?() {
    若 阶段 == 0 {
        若 R.键刚按下?(257) { 阶段 = 1 }
    }
    若 阶段 == 1 { 更新走() }
    若 阶段 == 2 {
        若 R.键刚按下?(257) { 阶段 = 3 }
    }
    若 阶段 == 3 { 更新锁() }
    若 阶段 == 4 {
        若 R.键刚按下?(257) { 阶段 = 5 }
    }
    若 阶段 == 5 {
        若 R.键刚按下?(256) { 退出 = 真 }
    }

    R.开始绘图()
    R.清背景(8, 7, 12, 255)

    若 阶段 == 0 {
        R.绘矩形(0, 0, 窗口宽, 窗口高, 6, 5, 10, 255)
        绘中("无尽回廊", 300, 250, 34, 200, 200, 214, 255)
        绘中("按回车开始", 330, 320, 20, 130, 130, 150, 255)
    } 否 {
        绘场景()
        若 阶段 == 1 {
            绘中(文一, 60, 40, 20, 190, 188, 200, 255)
            绘中(文二, 60, 74, 20, 190, 188, 200, 255)
            绘中("WASD 走动，走到铁门前", 60, 96, 18, 120, 118, 132, 255)
        }
        若 阶段 == 2 {
            绘中(文三, 60, 40, 20, 190, 188, 200, 255)
            绘框二(便条, 引子, 416, 88)
            绘中("按回车走近", 640, 528, 18, 140, 138, 150, 255)
        }
        若 阶段 == 3 {
            绘中(文二, 60, 40, 20, 190, 188, 200, 255)
            绘中(文三, 60, 74, 20, 190, 188, 200, 255)
            绘框二(便条, 引子, 416, 88)
            若 看门次数 > 0 {
                绘中(错白, 60, 500, 18, 180, 120, 120, 255)
            }
            绘中(提示, 60, 522, 18, 150, 148, 160, 255)
            绘框("输入：" & 补位(答案) & "     Q 放弃", 550, 44)
        }
        若 阶段 == 4 {
            若 撬过 { 绘框(撬白, 448, 74) }
            若 非 撬过 { 绘框(对白, 448, 74) }
            绘中("按回车继续", 330, 528, 18, 140, 138, 150, 255)
        }
        若 阶段 == 5 {
            R.绘矩形(0, 0, 窗口宽, 窗口高, 6, 5, 10, 255)
            绘中("门后是一段更长的走廊。", 250, 260, 24, 200, 200, 214, 255)
            绘中("（第一幕到此结束，按 ESC 退出）", 250, 310, 18, 130, 130, 150, 255)
        }
    }

    R.结束绘图()
    若 退出 { 断 }
}

R.关闭窗口()

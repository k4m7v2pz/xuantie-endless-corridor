// 主函数.xt — 无尽回廊 · 三幕可操控版
// ============================================================
// 剧情从 剧情/幕NN.json 运行时读取，本文件只承载引擎：
// 横向走廊、WASD 走动、走到右端触发节点、谜题输入、分支选择、幕间过场。
//
// 操作：回车=开始/推进；WASD/方向键=移动/选菜单；数字键=拨锁；Q=放弃谜题；
//       ESC=暂停；主菜单与暂停层支持鼠标点击。
// 节点类型：必经 / 谜题 / 绕过 / 分支 / 结局 —— 全部由 JSON 的「类型」字段驱动。
// ============================================================

引 "渲染" 予 R
外 函 XT_GetRenderWidth(): 整

// === 常量 ===
设 窗口宽 = 800
设 窗口高 = 600
设 通道上 = 260
设 通道下 = 470
设 玩家大小 = 24
设 速度 = 3
设 门x = 680

// === 全局状态 ===
// 阶段：0=标题 1=行走 2=谜题 3=分支 4=结局文本 5=过场 6=结果文本 7=全剧终
设 阶段 = 0
设 幕号 = 1
设 节点 = ""
设 玩家x = 60
设 玩家y = 320
设 答案 = ""
设 字体 = 0
设 错数 = 0
设 退出 = 假
设 暂停中 = 假
设 选项 = 0
设 本帧已关 = 假
设 主选 = 0
设 主提示 = ""
设 界面标题 = "无尽回廊"
设 字体路径 = "/System/Library/Fonts/Supplemental/Arial Unicode.ttf"
设 界面补充 = ""
设 主菜单项 = ["新游戏", "载入存档", "退出"]
设 暂停菜单项 = ["继续", "回到主菜单", "退出"]
设 鼠横 = 0
设 鼠纵 = 0

// === 剧情运行时数据 ===
设 幕数据 = 空
设 事件 = 空
设 正文行 = []
设 标题文 = ""
设 类 = ""

// 谜题
设 提示文 = ""
设 对白文 = ""
设 错白文 = ""
设 谜底一 = ""
设 谜底二 = ""
设 锁位 = 4
设 锁小 = 0
设 锁大 = 9

// 分支
设 选项一 = ""
设 选项一靶 = ""
设 选项二 = ""
设 选项二靶 = ""

// 过场 / 结果
设 过场行 = []
设 结果文 = ""
设 上末 = ""
设 下一节点 = ""

// === 读 JSON ===
函 读Json(路径) {
    设 读果 = 文件.读(路径)
    若 读果.成功 == 假 {
        示("读取失败：" & 路径)
        返 空
    }
    设 数据 = 解(读果.值)
    若 数据 == 空 {
        示("解析失败：" & 路径)
    }
    返 数据
}

// === 绘制：文字 ===
函 绘中(文本, x, y, 号, r, g, b, a) {
    R.绘字体文字(字体, 文本, x, y, 号, 1, r, g, b, a)
}

函 绘正中(文本, y, 号, r, g, b, a) {
    设 宽 = R.量字体文字(字体, 文本, 号, 1)
    绘中(文本, (窗口宽 - 宽) / 2, y, 号, r, g, b, a)
}

// 顶部正文区：多行左对齐
函 绘正文() {
    设 i = 0
    遍历 行 于 正文行 {
        绘中(行, 40, 36 + i * 26, 16, 190, 188, 200, 255)
        i = i + 1
    }
    若 标题文 != "" {
        绘中("── " & 标题文 & " ──", 40, 10, 14, 120, 118, 132, 255)
    }
}

// === 载入 ===
函 载节点(编号) {
    节点 = 编号
    设 n = 事件[编号]
    若 n == 空 {
        示("剧情断了：找不到节点 " & 编号)
        返 0
    }
    标题文 = n["标题"]
    正文行 = n["正文"]
    类 = n["类型"]
    阶段 = 1
    玩家x = 60
    错数 = 0
    答案 = ""

    若 类 == "谜题" {
        设 谜 = n["谜题"]
        提示文 = 谜["提示"]
        对白文 = 谜["对白"]
        错白文 = 谜["错白"]
        谜底一 = 谜["答案"]
        谜底二 = ""
        锁位 = 谜底一.长度
        若 幕号 == 2 { 锁小 = 1 }
        若 幕号 == 2 { 锁大 = 3 }
        若 幕号 != 2 { 锁小 = 0 }
        若 幕号 != 2 { 锁大 = 9 }
        设 可 = 谜["可接受"]
        若 可 != 空 {
            遍历 项 于 可 {
                若 项 != 谜底一 { 谜底二 = 项 }
            }
        }
    }

    若 类 == "分支" {
        设 选项表 = n["选项"]
        选项一 = 选项表[0]["文字"]
        选项一靶 = 选项表[0]["到"]
        选项二 = 选项表[1]["文字"]
        选项二靶 = 选项表[1]["到"]
    }
    返 1
}

函 载幕(号) {
    幕号 = 号
    幕数据 = 读Json("剧情/幕0" & 字(号) & ".json")
    若 幕数据 == 空 { 返 0 }
    事件 = 幕数据["事件"]
    返 载节点(幕数据["起始"])
}

// 进入下一幕：先播过场，再载起始节点
函 进下幕() {
    上末 = 节点
    设 新号 = 幕号 + 1
    若 新号 > 3 {
        阶段 = 7
        返 0
    }
    幕号 = 新号
    幕数据 = 读Json("剧情/幕0" & 字(幕号) & ".json")
    若 幕数据 == 空 { 返 0 }
    事件 = 幕数据["事件"]
    过场行 = []
    设 场表 = 幕数据["过场"]
    若 场表 != 空 {
        设 段 = 场表[上末]
        若 段 != 空 { 过场行 = 段 }
    }
    若 过场行.长度 > 0 {
        阶段 = 5
    }
    若 过场行.长度 == 0 {
        载节点(幕数据["起始"])
    }
    返 1
}

// === 更新：移动 ===
函 更新走() {
    设 步 = 速度
    若 R.键按下?(87) 或 R.键按下?(265) {
        设 ny = 玩家y - 步
        若 ny >= 通道上 + 2 { 玩家y = ny }
    }
    若 R.键按下?(83) 或 R.键按下?(264) {
        设 ny = 玩家y + 步
        若 ny <= 通道下 - 玩家大小 - 2 { 玩家y = ny }
    }
    若 R.键按下?(65) 或 R.键按下?(263) {
        设 nx = 玩家x - 步
        若 nx >= 40 { 玩家x = nx }
    }
    若 R.键按下?(68) 或 R.键按下?(262) {
        设 nx = 玩家x + 步
        若 nx <= 门x - 玩家大小 - 4 { 玩家x = nx }
    }
}

// 是否已走到右端触发点
函 到门() {
    若 玩家x >= 门x - 玩家大小 - 6 { 返 真 }
    返 假
}

// === 更新：谜题 ===
函 更新锁() {
    若 锁小 == 1 {
        若 R.键刚按下?(49) { 若 答案.长度 < 锁位 { 答案 = 答案 & "1" } }
        若 R.键刚按下?(50) { 若 答案.长度 < 锁位 { 答案 = 答案 & "2" } }
        若 R.键刚按下?(51) { 若 答案.长度 < 锁位 { 答案 = 答案 & "3" } }
    }
    若 锁小 == 0 {
        若 R.键刚按下?(48) { 若 答案.长度 < 锁位 { 答案 = 答案 & "0" } }
        若 R.键刚按下?(49) { 若 答案.长度 < 锁位 { 答案 = 答案 & "1" } }
        若 R.键刚按下?(50) { 若 答案.长度 < 锁位 { 答案 = 答案 & "2" } }
        若 R.键刚按下?(51) { 若 答案.长度 < 锁位 { 答案 = 答案 & "3" } }
        若 R.键刚按下?(52) { 若 答案.长度 < 锁位 { 答案 = 答案 & "4" } }
        若 R.键刚按下?(53) { 若 答案.长度 < 锁位 { 答案 = 答案 & "5" } }
        若 R.键刚按下?(54) { 若 答案.长度 < 锁位 { 答案 = 答案 & "6" } }
        若 R.键刚按下?(55) { 若 答案.长度 < 锁位 { 答案 = 答案 & "7" } }
        若 R.键刚按下?(56) { 若 答案.长度 < 锁位 { 答案 = 答案 & "8" } }
        若 R.键刚按下?(57) { 若 答案.长度 < 锁位 { 答案 = 答案 & "9" } }
    }
    若 R.键刚按下?(259) { 若 答案.长度 > 0 { 答案 = 答案[0..答案.长度 - 1] } }

    // 放弃：走绕过节点
    若 R.键刚按下?(81) {
        下一节点 = 事件[节点]["谜题"]["错"]
        结果文 = "你没再试。旁边有一条更难看的路。"
        阶段 = 6
    }
    // 错误次数到上限，自动放行（不把玩家卡死）
    若 错数 >= 3 {
        下一节点 = 事件[节点]["谜题"]["错"]
        结果文 = "你试了太多次，锁没动。你换了个办法。"
        阶段 = 6
    }

    若 R.键刚按下?(257) {
        设 行 = 假
        若 答案 == 谜底一 { 行 = 真 }
        若 谜底二 != "" { 若 答案 == 谜底二 { 行 = 真 } }
        若 行 {
            下一节点 = 事件[节点]["谜题"]["对"]
            结果文 = 对白文
            阶段 = 6
        }
        若 非 行 {
            错数 = 错数 + 1
            答案 = ""
        }
    }
}

// === 绘制：场景 ===
函 绘场景() {
    // 上下墙
    R.绘矩形(0, 0, 窗口宽, 通道上, 16, 15, 22, 255)
    R.绘矩形(0, 通道下, 窗口宽, 窗口高 - 通道下, 16, 15, 22, 255)

    // 地板：第一幕干、第二幕有水、第三幕台阶
    若 幕号 == 1 { R.绘矩形(0, 通道上, 窗口宽, 通道下 - 通道上, 38, 36, 48, 255) }
    若 幕号 == 2 { R.绘矩形(0, 通道上, 窗口宽, 通道下 - 通道上, 30, 34, 42, 255) }
    若 幕号 == 3 { R.绘矩形(0, 通道上, 窗口宽, 通道下 - 通道上, 36, 34, 40, 255) }

    // 第一幕：墙上 27 道粉笔划痕
    若 幕号 == 1 {
        设 i = 0
        当 i < 27 {
            R.绘直线(90 + i * 20, 214, 90 + i * 20, 244, 232, 230, 214, 210)
            i = i + 1
        }
    }

    // 第二幕：墙上红漆三字，位置是乱的（回 / 别 / 头）
    若 幕号 == 2 {
        R.绘矩形(300, 200, 80, 56, 44, 14, 16, 255)
        绘中("回", 324, 206, 16, 190, 60, 52, 255)
        绘中("别", 324, 226, 16, 190, 60, 52, 255)
        绘中("头", 324, 246, 16, 190, 60, 52, 255)
        // 薄水
        R.绘矩形(0, 通道下 - 14, 窗口宽, 14, 26, 34, 44, 255)
    }

    // 第三幕：台阶（12 级，第 7 级是空的）
    若 幕号 == 3 {
        设 i = 0
        当 i < 12 {
            设 x = 60 + i * 48
            若 i == 6 {
                R.绘矩形(x, 通道上 + 10, 48, 通道下 - 通道上 - 20, 8, 7, 12, 255)
            }
            若 i != 6 {
                R.绘矩形(x, 通道上 + 10, 46, 通道下 - 通道上 - 20, 30, 28, 36, 255)
                R.绘矩形线(x, 通道上 + 10, 46, 通道下 - 通道上 - 20, 56, 54, 66, 255)
            }
            i = i + 1
        }
    }

    // 右端：铁门 / 栅栏 / 铁门
    R.绘矩形(门x, 通道上, 30, 通道下 - 通道上, 52, 48, 44, 255)
    R.绘矩形线(门x, 通道上, 30, 通道下 - 通道上, 88, 82, 74, 255)
    R.绘圆(门x + 15, 320, 12, 96, 90, 82, 255)

    // 玩家 + 手电筒光圈
    设 cx = 玩家x + 玩家大小 / 2
    设 cy = 玩家y + 玩家大小 / 2
    R.绘矩形(玩家x, 玩家y, 玩家大小, 玩家大小, 148, 146, 158, 255)
    R.绘圆(cx, cy, 170, 96, 94, 116, 12)
    R.绘圆(cx, cy, 120, 108, 106, 128, 20)
    R.绘圆(cx, cy, 76, 124, 122, 144, 30)
    R.绘圆(cx, cy, 40, 140, 138, 160, 42)
}

// 底部框
函 绘框(文本, y, 高) {
    R.绘矩形(40, y - 10, 窗口宽 - 80, 高, 8, 8, 12, 230)
    R.绘矩形线(40, y - 10, 窗口宽 - 80, 高, 70, 68, 84, 255)
    绘中(文本, 60, y, 18, 226, 224, 232, 255)
}

// 点是否落在矩形内
函 命中?(mx, my, x, y, w, h) {
    若 mx < x { 返 假 }
    若 mx >= x + w { 返 假 }
    若 my < y { 返 假 }
    若 my >= y + h { 返 假 }
    返 真
}

// 主菜单确认
函 主菜单确认() {
    若 主选 == 0 {
        主提示 = ""
        若 载幕(1) == 0 { 阶段 = 7 }
    }
    若 主选 == 1 { 主提示 = "尚无存档" }
    若 主选 == 2 { 退出 = 真 }
}

// 暂停层确认
函 暂停确认() {
    若 选项 == 0 { 暂停中 = 假 }
    若 选项 == 1 {
        暂停中 = 假
        阶段 = 0
        玩家x = 60
    }
    若 选项 == 2 { 退出 = 真 }
}

函 绘暂停层() {
    R.绘矩形(0, 0, 窗口宽, 窗口高, 3, 3, 6, 200)
    R.绘矩形(240, 170, 320, 260, 10, 10, 16, 245)
    R.绘矩形线(240, 170, 320, 260, 92, 88, 102, 255)
    绘正中("暂停", 200, 24, 210, 208, 220, 255)
    设 i = 0
    遍历 行 于 暂停菜单项 {
        设 y = 262 + i * 52
        若 i == 选项 {
            R.绘矩形(300, y - 6, 200, 40, 52, 48, 62, 255)
            R.绘矩形(300, y - 6, 4, 40, 200, 196, 210, 255)
        }
        绘正中(行, y, 20, 222, 220, 230, 255)
        i = i + 1
    }
    绘正中("上下键选择，回车确认，ESC 返回", 402, 15, 120, 118, 132, 255)
}

// === 主程序 ===
// 界面文案（可换皮）：标题 + 主菜单三项 + 暂停菜单三项；缺字段回退内置默认
设 界面 = 读Json("剧情/界面.json")
若 界面 != 空 {
    若 界面["标题"] != 空 { 界面标题 = 界面["标题"] }
    若 界面["菜单一"] != 空 {
        若 界面["菜单二"] != 空 {
            若 界面["菜单三"] != 空 {
                主菜单项 = [界面["菜单一"], 界面["菜单二"], 界面["菜单三"]]
            }
        }
    }
    若 界面["字体"] != 空 { 字体路径 = 界面["字体"] }
    若 界面["补充字"] != 空 {
        界面补充 = 界面["补充字"]
    }
    若 界面["暂停一"] != 空 {
        若 界面["暂停二"] != 空 {
            若 界面["暂停三"] != 空 {
                暂停菜单项 = [界面["暂停一"], 界面["暂停二"], 界面["暂停三"]]
            }
        }
    }
}

R.初始化窗口(窗口宽, 窗口高, 界面标题)
R.设ESC关闭(假)
R.设置目标帧率(60)

// 字体参考：三份剧情 JSON 原文（覆盖所有中文）+ 界面固定字
设 参考 = ""
遍历 路径 于 ["剧情/幕01.json", "剧情/幕02.json", "剧情/幕03.json"] {
    设 果 = 文件.读(路径)
    若 果.成功 { 参考 = 参考 & 果.值 }
}
参考 = 参考 & "（）按回车开始继续上走下走输入拨位回车确认放弃已次数第幕全剧终退出无尽回廊走动到门前障碍左墙右门楼梯0123456789Q_─—·；：上下键选择回车确认返回暂停继续回到标题退出新游戏载入存档主菜单尚无鼠标可点⌘⌥⇧⌃⌫←↑→↓"
参考 = 参考 & 界面标题
参考 = 参考 & 界面补充
遍历 行 于 主菜单项 { 参考 = 参考 & 行 }
遍历 行 于 暂停菜单项 { 参考 = 参考 & 行 }

// 图集光栅化字号 = 全项目最大绘制字号 × 屏幕像素比
// 不乘像素比的话，Retina(2x) 上 40 号字实际占 80 物理像素，图集放大会糊。
设 字体基准 = 40
设 像素比 = 1
若 R.取屏幕宽() > 0 {
    像素比 = XT_GetRenderWidth() / R.取屏幕宽()
}
若 像素比 < 1 { 像素比 = 1 }
字体 = R.加载字体精准(字体路径, 字体基准 * 像素比, 参考)

当 非 R.窗口应关闭?() {

    鼠横 = R.鼠X()
    鼠纵 = R.鼠Y()

    // ---- 更新 ----
    若 阶段 == 0 {
        若 R.键刚按下?(265) { 主选 = 主选 - 1 }
        若 R.键刚按下?(87) { 主选 = 主选 - 1 }
        若 R.键刚按下?(264) { 主选 = 主选 + 1 }
        若 R.键刚按下?(83) { 主选 = 主选 + 1 }
        设 悬 = -1
        设 j = 0
        遍历 行 于 主菜单项 {
            若 命中?(鼠横, 鼠纵, 280, 314 + j * 56, 240, 44) { 悬 = j }
            j = j + 1
        }
        若 悬 >= 0 { 主选 = 悬 }
        若 主选 < 0 { 主选 = 2 }
        若 主选 > 2 { 主选 = 0 }
        若 R.键刚按下?(257) { 主菜单确认() }
        若 R.鼠标刚按下?(0) {
            若 悬 >= 0 { 主菜单确认() }
        }
    }

    // 行走：走到右端后按回车，按节点类型分流
    若 阶段 == 1 且 非 暂停中 {
        更新走()
        若 到门() {
            若 R.键刚按下?(257) {
                若 类 == "谜题" { 阶段 = 2 }
                若 类 == "分支" { 阶段 = 3 }
                若 类 == "结局" { 阶段 = 4 }
                若 类 == "必经" { 载节点(事件[节点]["后继"]) }
                若 类 == "绕过" { 载节点(事件[节点]["后继"]) }
            }
        }
    }

    // 谜题
    若 阶段 == 2 { 更新锁() }

    // 分支：1 / 2 选一条
    若 阶段 == 3 且 非 暂停中 {
        若 R.键刚按下?(49) { 载节点(选项一靶) }
        若 R.键刚按下?(50) { 载节点(选项二靶) }
    }

    // 结局文本：回车进入下一幕
    若 阶段 == 4 且 非 暂停中 {
        若 R.键刚按下?(257) { 进下幕() }
    }

    // 过场：回车进入本幕起始节点
    若 阶段 == 5 且 非 暂停中 {
        若 R.键刚按下?(257) { 载节点(幕数据["起始"]) }
    }

    // 结果文本：回车前往下一节点
    若 阶段 == 6 且 非 暂停中 {
        若 R.键刚按下?(257) { 载节点(下一节点) }
    }

    // ---- 暂停层：开着吞掉所有世界输入；关着时 ESC 才能开 ----
    若 暂停中 {
        若 R.键刚按下?(265) { 选项 = 选项 - 1 }
        若 R.键刚按下?(87) { 选项 = 选项 - 1 }
        若 R.键刚按下?(264) { 选项 = 选项 + 1 }
        若 R.键刚按下?(83) { 选项 = 选项 + 1 }
        设 悬 = -1
        设 j = 0
        遍历 行 于 暂停菜单项 {
            若 命中?(鼠横, 鼠纵, 300, 262 + j * 52 - 6, 200, 40) { 悬 = j }
            j = j + 1
        }
        若 悬 >= 0 { 选项 = 悬 }
        若 选项 < 0 { 选项 = 2 }
        若 选项 > 2 { 选项 = 0 }
        若 R.键刚按下?(257) { 暂停确认() }
        若 R.鼠标刚按下?(0) {
            若 悬 >= 0 { 暂停确认() }
        }
        若 R.键刚按下?(256) {
            暂停中 = 假
            本帧已关 = 真
        }
    }
    若 非 暂停中 {
        若 非 本帧已关 {
            若 阶段 >= 1 {
                若 阶段 <= 6 {
                    若 R.键刚按下?(256) {
                        暂停中 = 真
                        选项 = 0
                    }
                }
            }
        }
    }
    本帧已关 = 假

    若 阶段 == 7 {
        若 R.键刚按下?(256) { 退出 = 真 }
        若 R.键刚按下?(257) { 退出 = 真 }
    }

    // ---- 绘制 ----
    R.开始绘图()
    R.清背景(8, 7, 12, 255)

    若 阶段 == 0 {
        R.绘矩形(0, 0, 窗口宽, 窗口高, 6, 5, 10, 255)
        绘正中(界面标题, 196, 40, 192, 64, 72, 255)
        R.绘矩形(320, 258, 160, 2, 88, 84, 96, 255)
        设 i = 0
        遍历 行 于 主菜单项 {
            设 y = 314 + i * 56
            若 i == 主选 {
                R.绘矩形(280, y, 240, 44, 24, 22, 30, 255)
                R.绘矩形(280, y, 3, 44, 190, 76, 84, 255)
            }
            绘正中(行, y + 11, 22, 214, 210, 224, 255)
            i = i + 1
        }
        若 主提示 != ""
        {
            绘正中(主提示, 500, 16, 190, 110, 112, 255)
        }
        绘正中("上下键选择，回车确认，鼠标可点", 556, 14, 104, 100, 116, 255)
    }

    若 阶段 == 1 {
        绘场景()
        绘正文()
        若 到门() {
            绘正中("按回车继续", 530, 18, 150, 148, 160, 255)
        }
        若 非 到门() {
            绘正中("WASD 走动，走到右端", 530, 18, 110, 108, 122, 255)
        }
    }

    若 阶段 == 2 且 非 暂停中 {
        绘场景()
        绘正文()
        绘框(提示文, 482, 50)
        若 错数 > 0 { 绘中(错白文, 60, 526, 14, 180, 120, 120, 255) }
        绘正中("数字键拨 " & 字(锁位) & " 位，回车确认；Q 放弃", 540, 15, 130, 128, 142, 255)
        绘框("输入：" & 答案 & "     已试 " & 字(错数) & " 次", 566, 40)
    }

    若 阶段 == 3 {
        绘场景()
        绘正文()
        // 两扇门：上=亮灯，下=全黑
        R.绘矩形(门x - 44, 300, 44, 62, 232, 222, 176, 255)
        R.绘矩形(门x - 44, 380, 44, 62, 10, 9, 14, 255)
        R.绘矩形线(门x - 44, 300, 44, 62, 250, 240, 200, 255)
        R.绘矩形线(门x - 44, 380, 44, 62, 60, 58, 70, 255)
        绘框("1  " & 选项一, 500, 40)
        绘框("2  " & 选项二, 552, 40)
    }

    若 阶段 == 4 {
        绘场景()
        绘正文()
        绘正中("按回车进入下一幕", 530, 18, 150, 148, 160, 255)
    }

    若 阶段 == 5 {
        R.绘矩形(0, 0, 窗口宽, 窗口高, 6, 5, 10, 255)
        设 i = 0
        遍历 行 于 过场行 {
            绘中(行, 60, 200 + i * 28, 18, 190, 188, 200, 255)
            i = i + 1
        }
        绘正中("按回车继续", 420, 18, 130, 130, 150, 255)
    }

    若 阶段 == 6 {
        绘场景()
        绘正文()
        绘框(结果文, 500, 56)
        绘正中("按回车继续", 560, 18, 150, 148, 160, 255)
    }

    若 阶段 == 7 {
        R.绘矩形(0, 0, 窗口宽, 窗口高, 6, 5, 10, 255)
        绘正中("你走完了这条走廊。", 240, 26, 200, 200, 214, 255)
        绘正中("（全剧终，按 ESC 退出）", 300, 18, 130, 130, 150, 255)
    }

    若 暂停中 { 绘暂停层() }

    R.结束绘图()
    若 退出 { 断 }
}

R.关闭窗口()
